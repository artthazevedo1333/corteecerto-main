<file path="src/components/dashboard/ScheduleBlocksManager.tsx">
import { useEffect, useState } from "react";
import {
  Dialog,
  DialogContent,
  DialogHeader,
  DialogTitle,
  DialogTrigger,
} from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { supabase } from "@/integrations/supabase/client";
import { toast } from "sonner";
import { Ban, Coffee, Plane, Trash2, Loader2, Lock } from "lucide-react";
import { format } from "date-fns";
import { ptBR } from "date-fns/locale";

type BlockType = "block" | "vacation" | "lunch";

interface ScheduleBlocksManagerProps {
  selectedDate?: Date;
  onChange?: () => void;
}

const BLOCK_META: Record<BlockType, { label: string; icon: any; color: string }> = {
  block: { label: "Bloqueio", icon: Ban, color: "text-red-500" },
  lunch: { label: "Almoço/Pausa", icon: Coffee, color: "text-orange-500" },
  vacation: { label: "Férias", icon: Plane, color: "text-blue-500" },
};

export function ScheduleBlocksManager({ selectedDate, onChange }: ScheduleBlocksManagerProps) {
  const [open, setOpen] = useState(false);
  const [blocks, setBlocks] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);

  const [type, setType] = useState<BlockType>("block");
  const [title, setTitle] = useState("");
  const [startDate, setStartDate] = useState(
    selectedDate ? format(selectedDate, "yyyy-MM-dd") : format(new Date(), "yyyy-MM-dd"),
  );
  const [startTime, setStartTime] = useState("12:00");
  const [endDate, setEndDate] = useState(
    selectedDate ? format(selectedDate, "yyyy-MM-dd") : format(new Date(), "yyyy-MM-dd"),
  );
  const [endTime, setEndTime] = useState("13:00");

  const load = async () => {
    setLoading(true);
    const {
      data: { user },
    } = await supabase.auth.getUser();
    if (!user) return setLoading(false);
    const { data } = await supabase
      .from("schedule_blocks")
      .select("*")
      .eq("user_id", user.id)
      .gte("end_time", new Date().toISOString())
      .order("start_time");
    setBlocks(data || []);
    setLoading(false);
  };

  useEffect(() => {
    if (open) load();
  }, [open]);

  const handleTypeChange = (t: BlockType) => {
    setType(t);
    if (t === "vacation") {
      setStartTime("00:00");
      setEndTime("23:59");
      setTitle("Férias");
    } else if (t === "lunch") {
      setStartTime("12:00");
      setEndTime("13:00");
      setTitle("Horário de almoço");
    } else {
      setTitle("");
    }
  };

  const create = async () => {
    if (!title.trim()) return toast.error("Informe um título");
    setSaving(true);
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) throw new Error("Não autenticado");
      const start = new Date(`${startDate}T${startTime}`);
      const end = new Date(`${endDate}T${endTime}`);
      if (end <= start) throw new Error("Fim deve ser depois do início");

      const { error } = await supabase.from("schedule_blocks").insert({
        user_id: user.id,
        title: title.trim(),
        block_type: type,
        start_time: start.toISOString(),
        end_time: end.toISOString(),
      });
      if (error) throw error;
      toast.success("Bloqueio criado");
      setTitle("");
      load();
      onChange?.();
    } catch (e: any) {
      toast.error(e.message || "Erro ao criar bloqueio");
    } finally {
      setSaving(false);
    }
  };

  const remove = async (id: string) => {
    const { error } = await supabase.from("schedule_blocks").delete().eq("id", id);
    if (error) return toast.error("Erro ao remover");
    toast.success("Bloqueio removido");
    load();
    onChange?.();
  };

  return (
    <Dialog open={open} onOpenChange={setOpen}>
      <DialogTrigger asChild>
        <Button
          variant="outline"
          className="h-14 px-6 font-black text-base rounded-xl gap-2 border-orange-500/30 text-orange-500 hover:bg-orange-500/5"
        >
          <Lock className="h-5 w-5" />
          BLOQUEAR
        </Button>
      </DialogTrigger>
      <DialogContent className="sm:max-w-[520px] p-6 rounded-3xl max-h-[90vh] overflow-y-auto">
        <DialogHeader className="mb-4">
          <DialogTitle className="text-2xl font-black uppercase tracking-tight italic">
            Bloqueios de Agenda
          </DialogTitle>
        </DialogHeader>

        <div className="space-y-5">
          {/* Type selector */}
          <div className="grid grid-cols-3 gap-2">
            {(Object.keys(BLOCK_META) as BlockType[]).map((t) => {
              const M = BLOCK_META[t];
              const Icon = M.icon;
              return (
                <button
                  key={t}
                  type="button"
                  onClick={() => handleTypeChange(t)}
                  className={`p-3 rounded-xl border-2 flex flex-col items-center gap-1 transition-all ${
                    type === t ? "border-primary bg-primary/5" : "border-border"
                  }`}
                >
                  <Icon className={`h-5 w-5 ${M.color}`} />
                  <span className="text-[10px] font-black uppercase tracking-widest">
                    {M.label}
                  </span>
                </button>
              );
            })}
          </div>

          <div className="space-y-2">
            <Label className="text-xs font-black uppercase tracking-widest">Título</Label>
            <Input
              value={title}
              onChange={(e) => setTitle(e.target.value)}
              className="h-11"
              placeholder="Ex: Compromisso pessoal"
            />
          </div>

          <div className="grid grid-cols-2 gap-3">
            <div className="space-y-2">
              <Label className="text-xs font-black uppercase tracking-widest">Início</Label>
              <Input
                type="date"
                value={startDate}
                onChange={(e) => setStartDate(e.target.value)}
                className="h-11"
              />
              <Input
                type="time"
                value={startTime}
                onChange={(e) => setStartTime(e.target.value)}
                className="h-11"
              />
            </div>
            <div className="space-y-2">
              <Label className="text-xs font-black uppercase tracking-widest">Fim</Label>
              <Input
                type="date"
                value={endDate}
                onChange={(e) => setEndDate(e.target.value)}
                className="h-11"
              />
              <Input
                type="time"
                value={endTime}
                onChange={(e) => setEndTime(e.target.value)}
                className="h-11"
              />
            </div>
          </div>

          <Button
            onClick={create}
            disabled={saving}
            className="w-full h-12 font-black uppercase rounded-xl"
          >
            {saving ? <Loader2 className="h-5 w-5 animate-spin" /> : "CRIAR BLOQUEIO"}
          </Button>

          <div className="border-t border-border pt-4">
            <p className="text-xs font-black uppercase tracking-widest text-muted-foreground mb-3">
              Bloqueios Ativos
            </p>
            {loading ? (
              <p className="text-sm text-muted-foreground">Carregando...</p>
            ) : blocks.length === 0 ? (
              <p className="text-sm text-muted-foreground">Nenhum bloqueio ativo.</p>
            ) : (
              <div className="space-y-2 max-h-60 overflow-y-auto">
                {blocks.map((b) => {
                  const M = BLOCK_META[b.block_type as BlockType] || BLOCK_META.block;
                  const Icon = M.icon;
                  return (
                    <div
                      key={b.id}
                      className="flex items-center gap-3 p-3 rounded-xl border border-border"
                    >
                      <Icon className={`h-4 w-4 ${M.color} shrink-0`} />
                      <div className="flex-1 min-w-0">
                        <p className="font-bold text-sm truncate">{b.title}</p>
                        <p className="text-xs text-muted-foreground">
                          {format(new Date(b.start_time), "dd/MM HH:mm", { locale: ptBR })} →{" "}
                          {format(new Date(b.end_time), "dd/MM HH:mm", { locale: ptBR })}
                        </p>
                      </div>
                      <Button
                        size="icon"
                        variant="ghost"
                        className="h-8 w-8 text-destructive"
                        onClick={() => remove(b.id)}
                      >
                        <Trash2 className="h-4 w-4" />
                      </Button>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </div>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/components/dashboard/ServiceForm.tsx">
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import * as z from "zod";
import { useTranslation } from "react-i18next";
import { useMemo } from "react";
import { Button } from "@/components/ui/button";
import {
  Form,
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from "@/components/ui/form";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Switch } from "@/components/ui/switch";
import { supabase } from "@/integrations/supabase/client";
import { toast } from "sonner";
import { Loader2 } from "lucide-react";

const SERVICE_COLORS = [
  "#3b82f6",
  "#ef4444",
  "#f59e0b",
  "#10b981",
  "#8b5cf6",
  "#ec4899",
  "#06b6d4",
  "#f97316",
  "#14b8a6",
  "#6366f1",
  "#84cc16",
  "#a855f7",
];

interface ServiceFormProps {
  service?: any;
  onSuccess: () => void;
  onCancel: () => void;
}

export function ServiceForm({ service, onSuccess, onCancel }: ServiceFormProps) {
  const { t } = useTranslation();
  const isEditing = !!service;

  const serviceSchema = useMemo(
    () =>
      z.object({
        name: z.string().min(2, "O nome deve ter pelo menos 2 caracteres"),
        description: z.string().optional(),
        price: z.coerce.number().min(0, "O preço deve ser maior ou igual a zero"),
        duration_minutes: z.coerce.number().min(1, "A duração deve ser de pelo menos 1 minuto"),
        color: z.string(),
        active: z.boolean(),
      }),
    [t],
  );

  type ServiceFormValues = z.infer<typeof serviceSchema>;

  const form = useForm<ServiceFormValues>({
    resolver: zodResolver(serviceSchema),
    defaultValues: {
      name: service?.name || "",
      description: service?.description || "",
      price: service?.price || 0,
      duration_minutes: service?.duration_minutes || 30,
      color: service?.color || "#3b82f6",
      active: service?.active ?? true,
    },
  });

  const onSubmit = async (values: ServiceFormValues) => {
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) throw new Error("Usuário não autenticado");

      if (isEditing) {
        const { error } = await supabase
          .from("services")
          .update({ ...values, updated_at: new Date().toISOString() })
          .eq("id", service.id);
        if (error) throw error;
        toast.success("Serviço atualizado!");
      } else {
        const { error } = await supabase.from("services").insert({ ...values, user_id: user.id });
        if (error) throw error;
        toast.success("Serviço criado!");
      }
      onSuccess();
    } catch (error: any) {
      console.error("Error saving service:", error);
      toast.error(error.message || "Erro ao salvar serviço");
    }
  };

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
        <FormField
          control={form.control}
          name="name"
          render={({ field }) => (
            <FormItem>
              <FormLabel className="text-sm font-black uppercase tracking-widest">
                Nome do Serviço
              </FormLabel>
              <FormControl>
                <Input
                  placeholder="Ex: Corte de Cabelo"
                  {...field}
                  className="h-12 text-lg font-bold"
                />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />

        <FormField
          control={form.control}
          name="description"
          render={({ field }) => (
            <FormItem>
              <FormLabel className="text-sm font-black uppercase tracking-widest">
                Descrição (Opcional)
              </FormLabel>
              <FormControl>
                <Textarea
                  placeholder="Detalhes sobre o serviço..."
                  {...field}
                  className="min-h-[100px] text-base font-medium"
                />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />

        <div className="grid grid-cols-2 gap-4">
          <FormField
            control={form.control}
            name="price"
            render={({ field }) => (
              <FormItem>
                <FormLabel className="text-sm font-black uppercase tracking-widest">
                  Preço (R$)
                </FormLabel>
                <FormControl>
                  <Input type="number" step="0.01" {...field} className="h-12 text-lg font-bold" />
                </FormControl>
                <FormMessage />
              </FormItem>
            )}
          />

          <FormField
            control={form.control}
            name="duration_minutes"
            render={({ field }) => (
              <FormItem>
                <FormLabel className="text-sm font-black uppercase tracking-widest">
                  Duração (Minutos)
                </FormLabel>
                <FormControl>
                  <Input type="number" {...field} className="h-12 text-lg font-bold" />
                </FormControl>
                <FormMessage />
              </FormItem>
            )}
          />
        </div>

        <FormField
          control={form.control}
          name="color"
          render={({ field }) => (
            <FormItem>
              <FormLabel className="text-sm font-black uppercase tracking-widest">
                Cor no Calendário
              </FormLabel>
              <FormControl>
                <div className="flex flex-wrap gap-2">
                  {SERVICE_COLORS.map((c) => (
                    <button
                      key={c}
                      type="button"
                      onClick={() => field.onChange(c)}
                      className={`h-10 w-10 rounded-xl border-2 transition-all ${
                        field.value === c ? "border-foreground scale-110" : "border-transparent"
                      }`}
                      style={{ backgroundColor: c }}
                      aria-label={`Selecionar cor ${c}`}
                    />
                  ))}
                </div>
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />

        <FormField
          control={form.control}
          name="active"
          render={({ field }) => (
            <FormItem className="flex items-center justify-between rounded-xl border border-border p-4">
              <div>
                <FormLabel className="text-sm font-black uppercase tracking-widest">
                  Serviço Ativo
                </FormLabel>
                <p className="text-xs text-muted-foreground mt-1">
                  Se desativado, não aparecerá na agenda.
                </p>
              </div>
              <FormControl>
                <Switch checked={field.value} onCheckedChange={field.onChange} />
              </FormControl>
            </FormItem>
          )}
        />

        <div className="flex gap-3 pt-4">
          <Button
            type="button"
            variant="outline"
            onClick={onCancel}
            className="flex-1 h-14 font-black uppercase tracking-widest rounded-xl"
          >
            CANCELAR
          </Button>
          <Button
            type="submit"
            disabled={form.formState.isSubmitting}
            className="flex-1 h-14 font-black uppercase tracking-widest rounded-xl shadow-lg shadow-primary/20"
          >
            {form.formState.isSubmitting ? (
              <Loader2 className="h-5 w-5 animate-spin" />
            ) : isEditing ? (
              "SALVAR"
            ) : (
              "CRIAR SERVIÇO"
            )}
          </Button>
        </div>
      </form>
    </Form>
  );
}
</file>

<file path="src/components/dashboard/ServiceFormulasAndCmv.tsx">
'use client';

import React, { useState, useEffect, useCallback } from 'react';
import { supabase } from '@/integrations/supabase/client';
import { toast } from 'sonner'; // Ou 'use-toast' do shadcn, dependendo da sua config
import { 
  Plus, 
  Trash2, 
  TrendingDown, 
  TrendingUp, 
  DollarSign, 
  Activity,
  Save,
  Loader2
} from 'lucide-react';

// Shadcn UI Components (Ajuste os imports conforme a estrutura do seu projeto)
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Input } from '@/components/ui/input';
import { Button } from '@/components/ui/button';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { Badge } from '@/components/ui/badge';
import { Skeleton } from '@/components/ui/skeleton';

// --- Types ---
type Service = { id: string; name: string; price: number };
type Product = { id: string; name: string; unit_measure: string; cost_price: number };
type FormulaItem = { id: string; product_id: string; quantity: number | string };
type CmvReport = {
  service_id: string;
  service_name: string;
  total_revenue: number;
  total_cogs: number;
  net_profit: number;
  margin_percentage: number;
  services_done: number;
};

export default function ServiceFormulasAndCmv() {
  // --- States ---
  const [activeTab, setActiveTab] = useState('formulas');
  
  // Data States
  const [services, setServices] = useState<Service[]>([]);
  const [products, setProducts] = useState<Product[]>([]);
  
  // Formulas States
  const [selectedServiceId, setSelectedServiceId] = useState<string>('');
  const [formulaItems, setFormulaItems] = useState<FormulaItem[]>([]);
  const [isLoadingFormulas, setIsLoadingFormulas] = useState(false);
  const [isSavingFormulas, setIsSavingFormulas] = useState(false);

  // CMV States
  const [cmvPeriod, setCmvPeriod] = useState<string>('7_days');
  const [cmvData, setCmvData] = useState<CmvReport[]>([]);
  const [isLoadingCmv, setIsLoadingCmv] = useState(false);

  // --- Data Fetching ---
  const fetchBaseData = async () => {
    try {
      const [servicesRes, productsRes] = await Promise.all([
        supabase.from('services').select('id, name, price').order('name'),
        supabase.from('products').select('id, name, unit_measure, cost_price').order('name') // Tabela de estoque
      ]);

      if (servicesRes.error) throw servicesRes.error;
      if (productsRes.error) throw productsRes.error;

      setServices(servicesRes.data || []);
      setProducts(productsRes.data || []);
    } catch (error: any) {
      toast.error('Erro ao carregar dados base: ' + error.message);
    }
  };

  useEffect(() => {
    fetchBaseData();
  }, []);

  // Fetch formulas when a service is selected
  useEffect(() => {
    if (!selectedServiceId) {
      setFormulaItems([]);
      return;
    }

    const fetchServiceFormulas = async () => {
      setIsLoadingFormulas(true);
      try {
        const { data, error } = await supabase
          .from('service_formulas') // Nome presumido da sua tabela de junção
          .select('id, product_id, quantity')
          .eq('service_id', selectedServiceId);

        if (error) throw error;
        
        // Mapeia adicionando um ID temporário se não existir, para a key do React
        setFormulaItems(data?.map(item => ({
          id: item.id || crypto.randomUUID(),
          product_id: item.product_id,
          quantity: item.quantity
        })) || []);
      } catch (error: any) {
        toast.error('Erro ao carregar a fórmula: ' + error.message);
      } finally {
        setIsLoadingFormulas(false);
      }
    };

    fetchServiceFormulas();
  }, [selectedServiceId]);

  // Fetch CMV Report when tab is active or period changes
  const fetchCmvReport = useCallback(async () => {
    if (activeTab !== 'cmv') return;
    
    setIsLoadingCmv(true);
    try {
      // Define as datas baseadas no seletor
      const endDate = new Date();
      const startDate = new Date();
      if (cmvPeriod === 'today') startDate.setDate(endDate.getDate());
      else if (cmvPeriod === '7_days') startDate.setDate(endDate.getDate() - 7);
      else if (cmvPeriod === '3_months') startDate.setMonth(endDate.getMonth() - 3);

      const { data, error } = await supabase.rpc('get_service_cmv_report', {
        start_date: startDate.toISOString().split('T')[0],
        end_date: endDate.toISOString().split('T')[0]
      });

      if (error) throw error;
      setCmvData(data || []);
    } catch (error: any) {
      toast.error('Erro ao gerar relatório CMV: ' + error.message);
    } finally {
      setIsLoadingCmv(false);
    }
  }, [activeTab, cmvPeriod]);

  useEffect(() => {
    fetchCmvReport();
  }, [fetchCmvReport]);

  // --- Handlers: Fórmulas ---
  const handleAddFormulaItem = () => {
    setFormulaItems(prev => [
      ...prev, 
      { id: crypto.randomUUID(), product_id: '', quantity: '' }
    ]);
  };

  const handleRemoveFormulaItem = (id: string) => {
    setFormulaItems(prev => prev.filter(item => item.id !== id));
  };

  const handleUpdateFormulaItem = (id: string, field: keyof FormulaItem, value: any) => {
    setFormulaItems(prev => prev.map(item => 
      item.id === id ? { ...item, [field]: value } : item
    ));
  };

  const handleSaveFormulas = async () => {
    if (!selectedServiceId) return;

    // Validação básica
    const invalidItems = formulaItems.filter(item => !item.product_id || Number(item.quantity) <= 0);
    if (invalidItems.length > 0) {
      toast.warning('Preencha corretamente todos os produtos e quantidades maiores que zero.');
      return;
    }

    setIsSavingFormulas(true);
    try {
      // 1. Remove as fórmulas antigas (estratégia replace-all)
      const { error: deleteError } = await supabase
        .from('service_formulas')
        .delete()
        .eq('service_id', selectedServiceId);
        
      if (deleteError) throw deleteError;

      // 2. Insere as novas fórmulas
      if (formulaItems.length > 0) {
        const payload = formulaItems.map(item => ({
          service_id: selectedServiceId,
          product_id: item.product_id,
          quantity: Number(item.quantity)
        }));

        const { error: insertError } = await supabase
          .from('service_formulas')
          .insert(payload);

        if (insertError) throw insertError;
      }

      toast.success('Fórmula de consumo salva com sucesso!');
    } catch (error: any) {
      toast.error('Erro ao salvar fórmula: ' + error.message);
    } finally {
      setIsSavingFormulas(false);
    }
  };

  // --- Helpers ---
  const formatCurrency = (value: number) => 
    new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value || 0);
  
  const formatPercent = (value: number) => 
    new Intl.NumberFormat('pt-BR', { style: 'percent', maximumFractionDigits: 1 }).format((value || 0) / 100);

  // CMV Totals Calculation
  const totalCmvRevenue = cmvData.reduce((acc, curr) => acc + curr.total_revenue, 0);
  const totalCmvCogs = cmvData.reduce((acc, curr) => acc + curr.total_cogs, 0);
  const totalCmvProfit = totalCmvRevenue - totalCmvCogs;
  const averageMargin = totalCmvRevenue > 0 ? (totalCmvProfit / totalCmvRevenue) * 100 : 0;

  return (
    <div className="w-full space-y-6">
      <div>
        <h2 className="text-3xl font-bold tracking-tight">Estoque & Lucratividade</h2>
        <p className="text-muted-foreground">
          Gerencie as fórmulas de consumo dos serviços e analise o Custo da Mercadoria Vendida (CMV).
        </p>
      </div>

      <Tabs value={activeTab} onValueChange={setActiveTab} className="w-full">
        <TabsList className="grid w-full grid-cols-2 max-w-md">
          <TabsTrigger value="formulas">Fórmulas de Consumo</TabsTrigger>
          <TabsTrigger value="cmv">Relatório CMV (Lucro Real)</TabsTrigger>
        </TabsList>

        {/* --- ABA 1: CONFIGURADOR DE FÓRMULAS --- */}
        <TabsContent value="formulas" className="space-y-4 pt-4">
          <Card>
            <CardHeader>
              <CardTitle>Configurador por Serviço</CardTitle>
              <CardDescription>
                Associe produtos do estoque que são consumidos na realização de um serviço.
              </CardDescription>
            </CardHeader>
            <CardContent className="space-y-6">
              
              <div className="flex flex-col gap-2 max-w-sm">
                <label className="text-sm font-medium">Selecione o Serviço</label>
                <Select value={selectedServiceId} onValueChange={setSelectedServiceId}>
                  <SelectTrigger>
                    <SelectValue placeholder="Escolha um serviço..." />
                  </SelectTrigger>
                  <SelectContent>
                    {services.map(srv => (
                      <SelectItem key={srv.id} value={srv.id}>{srv.name}</SelectItem>
                    ))}
                  </SelectContent>
                </Select>
              </div>

              {selectedServiceId && (
                <div className="border rounded-lg p-4 bg-muted/20 space-y-4">
                  <div className="flex items-center justify-between">
                    <h3 className="font-semibold text-lg">Insumos do Serviço</h3>
                    <Button onClick={handleAddFormulaItem} variant="outline" size="sm" className="gap-2">
                      <Plus className="h-4 w-4" /> Adicionar Insumo
                    </Button>
                  </div>

                  {isLoadingFormulas ? (
                    <div className="space-y-2">
                      <Skeleton className="h-12 w-full" />
                      <Skeleton className="h-12 w-full" />
                    </div>
                  ) : formulaItems.length === 0 ? (
                    <div className="text-center p-6 border border-dashed rounded-lg text-muted-foreground">
                      Nenhum insumo configurado para este serviço. Clique em adicionar.
                    </div>
                  ) : (
                    <div className="space-y-3">
                      {formulaItems.map((item, index) => (
                        <div key={item.id} className="flex items-end gap-3 fade-in slide-in-from-bottom-2">
                          <div className="flex-1 space-y-1">
                            <label className="text-xs font-medium text-muted-foreground">Produto do Estoque</label>
                            <Select 
                              value={item.product_id} 
                              onValueChange={(val) => handleUpdateFormulaItem(item.id, 'product_id', val)}
                            >
                              <SelectTrigger>
                                <SelectValue placeholder="Selecione o produto" />
                              </SelectTrigger>
                              <SelectContent>
                                {products.map(prod => (
                                  <SelectItem key={prod.id} value={prod.id}>
                                    {prod.name} ({prod.unit_measure}) - {formatCurrency(prod.cost_price)}
                                  </SelectItem>
                                ))}
                              </SelectContent>
                            </Select>
                          </div>
                          
                          <div className="w-32 space-y-1">
                            <label className="text-xs font-medium text-muted-foreground">Qtde Consumida</label>
                            <Input 
                              type="number"
                              min="0"
                              step="0.01"
                              placeholder="Ex: 0.5"
                              value={item.quantity}
                              onChange={(e) => handleUpdateFormulaItem(item.id, 'quantity', e.target.value)}
                            />
                          </div>

                          <Button 
                            variant="destructive" 
                            size="icon" 
                            onClick={() => handleRemoveFormulaItem(item.id)}
                            className="shrink-0"
                          >
                            <Trash2 className="h-4 w-4" />
                          </Button>
                        </div>
                      ))}
                    </div>
                  )}

                  <div className="pt-4 flex justify-end border-t">
                    <Button 
                      onClick={handleSaveFormulas} 
                      disabled={isSavingFormulas || isLoadingFormulas}
                      className="gap-2 w-full sm:w-auto"
                    >
                      {isSavingFormulas ? <Loader2 className="h-4 w-4 animate-spin" /> : <Save className="h-4 w-4" />}
                      Salvar Fórmula
                    </Button>
                  </div>
                </div>
              )}
            </CardContent>
          </Card>
        </TabsContent>

        {/* --- ABA 2: RELATÓRIO CMV --- */}
        <TabsContent value="cmv" className="space-y-4 pt-4">
          <div className="flex items-center justify-between bg-card p-4 rounded-lg border shadow-sm">
            <div className="space-y-1">
              <h3 className="font-semibold text-lg">Desempenho de Custo Real</h3>
              <p className="text-sm text-muted-foreground">Faturamento vs Custo de Produtos Consumidos</p>
            </div>
            <Select value={cmvPeriod} onValueChange={setCmvPeriod}>
              <SelectTrigger className="w-[180px]">
                <SelectValue placeholder="Período" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="today">Hoje</SelectItem>
                <SelectItem value="7_days">Últimos 7 dias</SelectItem>
                <SelectItem value="3_months">Últimos 3 meses</SelectItem>
              </SelectContent>
            </Select>
          </div>

          {isLoadingCmv ? (
            <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
              {[1,2,3,4].map(i => <Skeleton key={i} className="h-32 w-full rounded-xl" />)}
            </div>
          ) : (
            <>
              {/* Cards de Resumo */}
              <div className="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
                <Card>
                  <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                    <CardTitle className="text-sm font-medium">Faturamento (Serviços)</CardTitle>
                    <DollarSign className="h-4 w-4 text-muted-foreground" />
                  </CardHeader>
                  <CardContent>
                    <div className="text-2xl font-bold">{formatCurrency(totalCmvRevenue)}</div>
                  </CardContent>
                </Card>
                <Card>
                  <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                    <CardTitle className="text-sm font-medium">Custo Insumos (CMV)</CardTitle>
                    <TrendingDown className="h-4 w-4 text-destructive" />
                  </CardHeader>
                  <CardContent>
                    <div className="text-2xl font-bold text-destructive">{formatCurrency(totalCmvCogs)}</div>
                  </CardContent>
                </Card>
                <Card>
                  <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                    <CardTitle className="text-sm font-medium">Lucro Bruto Real</CardTitle>
                    <TrendingUp className="h-4 w-4 text-emerald-500" />
                  </CardHeader>
                  <CardContent>
                    <div className="text-2xl font-bold text-emerald-500">{formatCurrency(totalCmvProfit)}</div>
                  </CardContent>
                </Card>
                <Card>
                  <CardHeader className="flex flex-row items-center justify-between space-y-0 pb-2">
                    <CardTitle className="text-sm font-medium">Margem Média</CardTitle>
                    <Activity className="h-4 w-4 text-blue-500" />
                  </CardHeader>
                  <CardContent>
                    <div className="text-2xl font-bold text-blue-500">{formatPercent(averageMargin)}</div>
                  </CardContent>
                </Card>
              </div>

              {/* Tabela de Detalhamento por Serviço */}
              <Card>
                <CardHeader>
                  <CardTitle>Detalhamento por Serviço</CardTitle>
                  <CardDescription>Visualize quais serviços entregam a melhor e pior margem no período.</CardDescription>
                </CardHeader>
                <CardContent>
                  {cmvData.length === 0 ? (
                    <div className="text-center py-8 text-muted-foreground">
                      Nenhum dado financeiro encontrado para o período selecionado.
                    </div>
                  ) : (
                    <div className="rounded-md border">
                      <Table>
                        <TableHeader>
                          <TableRow>
                            <TableHead>Serviço</TableHead>
                            <TableHead className="text-right">Qtd. Realizada</TableHead>
                            <TableHead className="text-right">Faturamento</TableHead>
                            <TableHead className="text-right">Custo (CMV)</TableHead>
                            <TableHead className="text-right">Lucro</TableHead>
                            <TableHead className="text-right">Margem %</TableHead>
