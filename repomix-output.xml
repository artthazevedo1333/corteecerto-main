"use client";

import React, { useState, useEffect } from "react";
import { supabase } from "@/lib/supabase"; // Ajuste o caminho do seu client do Supabase
import { useToast } from "@/components/ui/use-toast"; // Hook padrão do Shadcn
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Input } from "@/components/ui/input";
import { Button } from "@/components/ui/button";
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { 
  Ticket, 
  Users, 
  Search, 
  Scissors, 
  PlusCircle, 
  Gift, 
  Loader2 
} from "lucide-react";

// Tipagens
interface Coupon {
  id: string;
  code: string;
  discount_type: "percentage" | "fixed";
  discount_value: number;
  expires_at: string;
  usage_count: number;
  active: boolean;
}

interface Client {
  id: string;
  name: string;
  phone: string;
  loyalty_points: number;
}

export default function MarketingSettings() {
  const { toast } = useToast();
  
  // Estados Globais e Métricas
  const [metrics, setMetrics] = useState({ loyalClients: 0, couponsUsedMonth: 0 });
  const [isLoadingMetrics, setIsLoadingMetrics] = useState(true);

  // Estados dos Cupons
  const [coupons, setCoupons] = useState<Coupon[]>([]);
  const [isLoadingCoupons, setIsLoadingCoupons] = useState(true);
  const [isCreatingCoupon, setIsCreatingCoupon] = useState(false);
  const [newCoupon, setNewCoupon] = useState({
    code: "",
    discount_type: "percentage",
    discount_value: "",
    expires_at: "",
  });

  // Estados do Cartão Fidelidade
  const [searchPhone, setSearchPhone] = useState("");
  const [foundClient, setFoundClient] = useState<Client | null>(null);
  const [isSearchingClient, setIsSearchingClient] = useState(false);
  const [isUpdatingPoints, setIsUpdatingPoints] = useState(false);

  useEffect(() => {
    fetchMetrics();
    fetchCoupons();
  }, []);

  // --- BUSCAS E MÉTRICAS ---
  const fetchMetrics = async () => {
    try {
      // Exemplo: Buscar total de clientes com pontos > 0 e cupons usados no mês atual
      // Ajuste as queries conforme a estrutura exata do seu DB
      const { count: loyalCount } = await supabase
        .from("clients")
        .select("*", { count: "exact", head: true })
        .gt("loyalty_points", 0);

      // Simulando busca de cupons usados no mês (pode ser uma query na tabela de agendamentos/pagamentos)
      const startOfMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString();
      const { count: couponsUsed } = await supabase
        .from("coupon_usages") // Ajuste para sua tabela de histórico de uso
        .select("*", { count: "exact", head: true })
        .gte("created_at", startOfMonth);

      setMetrics({
        loyalClients: loyalCount || 0,
        couponsUsedMonth: couponsUsed || 0,
      });
    } catch (error) {
      console.error("Erro ao carregar métricas:", error);
    } finally {
      setIsLoadingMetrics(false);
    }
  };

  const fetchCoupons = async () => {
    try {
      const { data, error } = await supabase
        .from("coupons")
        .select("*")
        .eq("active", true)
        .order("created_at", { ascending: false });

      if (error) throw error;
      setCoupons(data || []);
    } catch (error: any) {
      toast({
        title: "Erro ao carregar cupons",
        description: error.message,
        variant: "destructive",
      });
    } finally {
      setIsLoadingCoupons(false);
    }
  };

  // --- AÇÕES DE CUPOM ---
  const handleCreateCoupon = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsCreatingCoupon(true);
    
    try {
      const { data, error } = await supabase.from("coupons").insert([
        {
          code: newCoupon.code.toUpperCase(),
          discount_type: newCoupon.discount_type,
          discount_value: Number(newCoupon.discount_value),
          expires_at: newCoupon.expires_at,
          active: true,
          usage_count: 0,
        },
      ]).select().single();

      if (error) throw error;

      toast({
        title: "Cupom criado!",
        description: `O cupom ${data.code} foi ativado com sucesso.`,
      });
      
      setCoupons([data, ...coupons]);
      setNewCoupon({ code: "", discount_type: "percentage", discount_value: "", expires_at: "" });
    } catch (error: any) {
      toast({
        title: "Erro ao criar cupom",
        description: error.message,
        variant: "destructive",
      });
    } finally {
      setIsCreatingCoupon(false);
    }
  };

  // --- AÇÕES DE FIDELIDADE ---
  const handleSearchClient = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!searchPhone) return;
    
    setIsSearchingClient(true);
    setFoundClient(null);

    try {
      const { data, error } = await supabase
        .from("clients")
        .select("id, name, phone, loyalty_points")
        .eq("phone", searchPhone)
        .single();

      if (error) throw error;
      
      if (data) {
        setFoundClient(data);
      } else {
        toast({
          title: "Cliente não encontrado",
          description: "Verifique o número digitado.",
          variant: "destructive",
        });
      }
    } catch (error: any) {
      toast({
        title: "Erro na busca",
        description: "Cliente não encontrado ou número inválido.",
        variant: "destructive",
      });
    } finally {
      setIsSearchingClient(false);
    }
  };

  const handleLoyaltyAction = async (action: "add" | "redeem") => {
    if (!foundClient) return;
    setIsUpdatingPoints(true);

    try {
      if (action === "add") {
        // Chamando a RPC criada na Fase 5
        const { error } = await supabase.rpc("add_loyalty_points", {
          client_id: foundClient.id,
          points_to_add: 1, // Ajuste caso a pontuação seja dinâmica
        });
        if (error) throw error;

        setFoundClient({ ...foundClient, loyalty_points: foundClient.loyalty_points + 1 });
        toast({
          title: "Pontos adicionados!",
          description: "O saldo do cliente foi atualizado com sucesso.",
        });
        
      } else if (action === "redeem") {
        // Zera os pontos ou reduz (ajuste conforme a regra de negócio da barbearia)
        const { error } = await supabase
          .from("clients")
          .update({ loyalty_points: 0 })
          .eq("id", foundClient.id);
          
        if (error) throw error;

        setFoundClient({ ...foundClient, loyalty_points: 0 });
        toast({
          title: "Prêmio resgatado! ✂️",
          description: "Os pontos foram zerados e o corte grátis foi validado.",
        });
      }
      
      // Atualiza a métrica global silenciossamente
      fetchMetrics();
    } catch (error: any) {
      toast({
        title: "Erro ao atualizar fidelidade",
        description: error.message,
        variant: "destructive",
      });
    } finally {
      setIsUpdatingPoints(false);
    }
  };

  return (
    <div className="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
      
      {/* 3. Resumo de Engajamento */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        <Card className="bg-card/50 border-primary/20 backdrop-blur-sm">
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-sm font-medium text-muted-foreground">
              Total de Clientes Fidelizados
            </CardTitle>
            <Users className="h-4 w-4 text-primary" />
          </CardHeader>
          <CardContent>
            <div className="text-3xl font-bold">
              {isLoadingMetrics ? <Loader2 className="h-6 w-6 animate-spin" /> : metrics.loyalClients}
            </div>
            <p className="text-xs text-muted-foreground mt-1">Clientes com 1 ou mais pontos</p>
          </CardContent>
        </Card>

        <Card className="bg-card/50 border-primary/20 backdrop-blur-sm">
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-sm font-medium text-muted-foreground">
              Cupons Utilizados no Mês
            </CardTitle>
            <Ticket className="h-4 w-4 text-primary" />
          </CardHeader>
          <CardContent>
            <div className="text-3xl font-bold">
              {isLoadingMetrics ? <Loader2 className="h-6 w-6 animate-spin" /> : metrics.couponsUsedMonth}
            </div>
            <p className="text-xs text-muted-foreground mt-1">Geração de novas retenções</p>
          </CardContent>
        </Card>
      </div>

      <div className="grid grid-cols-1 xl:grid-cols-12 gap-8">
        
        {/* 2. Gerenciador do Cartão Fidelidade */}
        <Card className="xl:col-span-5 flex flex-col h-full border-border/50">
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <Scissors className="w-5 h-5 text-primary" />
              Cartão Fidelidade
            </CardTitle>
            <CardDescription>
              Busque o cliente pelo telefone para adicionar pontos ou resgatar prêmios.
            </CardDescription>
          </CardHeader>
          <CardContent className="flex-1 flex flex-col">
            <form onSubmit={handleSearchClient} className="flex gap-3 mb-6">
              <Input
                placeholder="Telefone (Ex: 11999999999)"
                value={searchPhone}
                onChange={(e) => setSearchPhone(e.target.value)}
                className="flex-1"
              />
              <Button type="submit" disabled={isSearchingClient || !searchPhone}>
                {isSearchingClient ? <Loader2 className="h-4 w-4 animate-spin" /> : <Search className="h-4 w-4" />}
              </Button>
            </form>

            {foundClient ? (
              <div className="bg-muted/30 border border-border/50 p-6 rounded-xl text-center space-y-4 flex-1 flex flex-col justify-center">
                <div>
                  <h3 className="text-xl font-bold">{foundClient.name}</h3>
                  <p className="text-sm text-muted-foreground">{foundClient.phone}</p>
                </div>
                
                <div className="py-4">
                  <span className="text-5xl font-black text-primary">{foundClient.loyalty_points}</span>
                  <span className="text-muted-foreground ml-2">pontos</span>
                </div>

                <div className="flex gap-3 justify-center w-full mt-auto">
                  <Button 
                    className="w-full gap-2" 
                    onClick={() => handleLoyaltyAction("add")}
                    disabled={isUpdatingPoints}
                  >
                    <PlusCircle className="w-4 h-4" />
                    Adicionar Ponto
                  </Button>
                  <Button 
                    variant="secondary" 
                    className="w-full gap-2 border-primary/20 hover:border-primary/50 transition-colors"
                    onClick={() => handleLoyaltyAction("redeem")}
                    disabled={isUpdatingPoints || foundClient.loyalty_points === 0}
                  >
                    <Gift className="w-4 h-4" />
                    Resgatar
                  </Button>
                </div>
              </div>
            ) : (
              <div className="flex-1 flex flex-col items-center justify-center text-muted-foreground border-2 border-dashed border-border/50 rounded-xl p-8">
                <Users className="w-12 h-12 mb-3 opacity-20" />
                <p>Nenhum cliente selecionado</p>
              </div>
            )}
          </CardContent>
        </Card>

        {/* 1. Painel de Controle de Cupons */}
        <Card className="xl:col-span-7 border-border/50">
          <CardHeader>
            <CardTitle className="flex items-center gap-2">
              <Ticket className="w-5 h-5 text-primary" />
              Gestão de Cupons Promocionais
            </CardTitle>
            <CardDescription>
              Crie códigos de desconto para atrair e reter seus clientes.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-6">
            
            {/* Formulário de Criação */}
            <form onSubmit={handleCreateCoupon} className="grid grid-cols-2 md:grid-cols-4 gap-4 items-end bg-muted/20 p-4 rounded-lg border border-border/50">
              <div className="space-y-2 col-span-2 md:col-span-1">
                <label className="text-xs font-medium">Código</label>
                <Input 
                  placeholder="EX: CORTE10" 
                  value={newCoupon.code}
                  onChange={(e) => setNewCoupon({...newCoupon, code: e.target.value})}
                  required
                />
              </div>
              <div className="space-y-2">
                <label className="text-xs font-medium">Tipo</label>
                <Select 
                  value={newCoupon.discount_type} 
                  onValueChange={(val: "percentage" | "fixed") => setNewCoupon({...newCoupon, discount_type: val})}
                >
                  <SelectTrigger>
                    <SelectValue placeholder="Tipo" />
                  </SelectTrigger>
                  <SelectContent>
                    <SelectItem value="percentage">Porcentagem (%)</SelectItem>
                    <SelectItem value="fixed">Valor Fixo (R$)</SelectItem>
                  </SelectContent>
                </Select>
              </div>
              <div className="space-y-2">
                <label className="text-xs font-medium">Valor</label>
                <Input 
                  type="number" 
                  placeholder="10"
                  value={newCoupon.discount_value}
                  onChange={(e) => setNewCoupon({...newCoupon, discount_value: e.target.value})}
                  required
                />
              </div>
              <div className="space-y-2 col-span-2 md:col-span-1">
                <label className="text-xs font-medium">Expiração</label>
                <Input 
                  type="date"
                  value={newCoupon.expires_at}
                  onChange={(e) => setNewCoupon({...newCoupon, expires_at: e.target.value})}
                  required
                />
              </div>
              <div className="col-span-2 md:col-span-4 mt-2">
                <Button type="submit" className="w-full md:w-auto md:float-right gap-2" disabled={isCreatingCoupon}>
                  {isCreatingCoupon ? <Loader2 className="w-4 h-4 animate-spin" /> : <PlusCircle className="w-4 h-4" />}
                  Gerar Cupom
                </Button>
              </div>
            </form>

            {/* Tabela de Cupons Ativos */}
            <div className="rounded-md border border-border/50">
              <Table>
                <TableHeader className="bg-muted/50">
                  <TableRow>
                    <TableHead>Cupom</TableHead>
                    <TableHead>Desconto</TableHead>
                    <TableHead>Expira em</TableHead>
                    <TableHead className="text-right">Usos</TableHead>
                  </TableRow>
                </TableHeader>
                <TableBody>
                  {isLoadingCoupons ? (
                    <TableRow>
                      <TableCell colSpan={4} className="text-center py-8">
                        <Loader2 className="h-6 w-6 animate-spin mx-auto text-muted-foreground" />
                      </TableCell>
                    </TableRow>
                  ) : coupons.length === 0 ? (
                    <TableRow>
                      <TableCell colSpan={4} className="text-center py-8 text-muted-foreground">
                        Nenhum cupom ativo no momento.
                      </TableCell>
                    </TableRow>
                  ) : (
                    coupons.map((coupon) => (
                      <TableRow key={coupon.id}>
                        <TableCell className="font-medium">{coupon.code}</TableCell>
                        <TableCell>
                          {coupon.discount_type === "percentage" 
                            ? `${coupon.discount_value}%` 
                            : `R$ ${coupon.discount_value.toFixed(2)}`}
                        </TableCell>
                        <TableCell>{new Date(coupon.expires_at).toLocaleDateString('pt-BR')}</TableCell>
                        <TableCell className="text-right font-bold text-primary">{coupon.usage_count}</TableCell>
                      </TableRow>
                    ))
                  )}
                </TableBody>
              </Table>
            </div>

          </CardContent>
        </Card>
      </div>
    </div>
  );
}
</file>

<file path="src/components/dashboard/NextAppointment.tsx">
import { useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Clock, DollarSign, MessageCircle, Play, CheckCircle, User } from "lucide-react";
import { format } from "date-fns";
import { supabase } from "@/integrations/supabase/client";
import { toast } from "sonner";

interface NextAppointmentProps {
  appointment: any;
  onUpdate?: () => void;
}

export function NextAppointment({ appointment, onUpdate }: NextAppointmentProps) {
  const [loading, setLoading] = useState(false);

  if (!appointment) {
    return (
      <Card className="rounded-[2rem] border-dashed border-2 border-border bg-transparent shadow-none">
        <CardContent className="p-12 text-center">
          <div className="h-16 w-16 rounded-full bg-secondary flex items-center justify-center mx-auto mb-4">
            <Clock className="h-8 w-8 text-muted-foreground/30" />
          </div>
          <h3 className="text-xl font-black uppercase italic tracking-tight">Sem agendamentos</h3>
          <p className="text-muted-foreground font-medium mt-1">
            Sua agenda está livre por enquanto.
          </p>
        </CardContent>
      </Card>
    );
  }

  const handleStatusChange = async (newStatus: "in_progress" | "completed") => {
    setLoading(true);
    try {
      const { error } = await supabase
        .from("appointments")
        .update({ status: newStatus })
        .eq("id", appointment.id);

      if (error) throw error;

      if (newStatus === "completed") {
        // Record financial income automatically
        await supabase.from("financial_records").insert({
          user_id: appointment.user_id,
          amount: appointment.service?.price || 0,
          description: `Serviço: ${appointment.service?.name} - Cliente: ${appointment.client?.name}`,
          type: "income",
          category: "service",
          date: new Date().toISOString(),
        });

        // Update client last visit and total spent
        const { data: clientData } = await supabase
          .from("clients")
          .select("total_spent")
          .eq("id", appointment.client_id)
          .single();

        await supabase
          .from("clients")
          .update({
            last_visit: new Date().toISOString(),
            total_spent: (clientData?.total_spent || 0) + (appointment.service?.price || 0),
          })
          .eq("id", appointment.client_id);

        toast.success("Atendimento finalizado e financeiro atualizado!");
      } else {
        toast.success("Atendimento iniciado!");
      }

      onUpdate?.();
    } catch (error) {
      console.error("Error updating status:", error);
      toast.error("Erro ao atualizar status");
    } finally {
      setLoading(false);
    }
  };

  const sendWhatsApp = () => {
    const phone = appointment.client?.phone || "";
    const message = encodeURIComponent(
      `Olá, ${appointment.client?.name}! Aqui é da barbearia. Estou te aguardando para seu atendimento das ${format(new Date(appointment.start_time), "HH:mm")}.`,
    );
    window.open(`https://wa.me/55${phone.replace(/\D/g, "")}?text=${message}`, "_blank");
  };

  const is_in_progress = appointment.status === "in_progress";

  return (
    <Card
      className={`overflow-hidden rounded-[2.5rem] shadow-2xl transition-all border-none ${is_in_progress ? "bg-green-600 text-white shadow-green-600/20" : "bg-primary text-white shadow-primary/20"}`}
    >
      <CardContent className="p-0">
        <div className="flex flex-col md:flex-row">
          <div className="p-8 md:p-10 flex-1 border-white/10 border-b md:border-b-0 md:border-r">
            <div className="flex items-center gap-6 mb-8">
              <div className="h-20 w-20 rounded-3xl bg-white/20 flex items-center justify-center border border-white/30 text-white">
                <User className="h-10 w-10" />
              </div>
              <div>
                <div className="flex items-center gap-2 mb-1">
                  <span
                    className={`text-[10px] font-black uppercase tracking-[0.2em] px-2 py-0.5 rounded-full bg-white/20 border border-white/20`}
                  >
                    {is_in_progress ? "EM ATENDIMENTO" : "PRÓXIMO"}
                  </span>
                </div>
                <h3 className="text-3xl font-black italic tracking-tighter leading-none break-words">
                  {appointment.client?.name}
                </h3>
                <p className="font-bold mt-2 text-white/80">{appointment.service?.name}</p>
              </div>
            </div>

            <div className="grid grid-cols-2 gap-6">
              <div className="flex items-center gap-3">
                <div className="p-3 rounded-2xl bg-white/10 border border-white/20">
                  <Clock className="h-5 w-5" />
                </div>
                <div>
                  <p className="text-[10px] uppercase font-black tracking-widest opacity-70">
                    Horário
                  </p>
                  <p className="font-black text-xl leading-tight">
                    {format(new Date(appointment.start_time), "HH:mm")}
                  </p>
                </div>
              </div>
              <div className="flex items-center gap-3">
                <div className="p-3 rounded-2xl bg-white/10 border border-white/20">
                  <DollarSign className="h-5 w-5" />
                </div>
                <div>
                  <p className="text-[10px] uppercase font-black tracking-widest opacity-70">
                    Valor
                  </p>
                  <p className="font-black text-xl leading-tight">
                    R${" "}
                    {appointment.service?.price.toLocaleString("pt-BR", {
                      minimumFractionDigits: 2,
                    })}
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div className="p-8 md:p-10 flex flex-col gap-3 justify-center w-full md:w-72 bg-black/10">
            {!is_in_progress ? (
              <Button
                onClick={() => handleStatusChange("in_progress")}
                disabled={loading}
                className="w-full font-black h-14 text-base rounded-2xl bg-white text-primary hover:bg-white/90 shadow-xl shadow-black/20 gap-2"
              >
                <Play className="h-5 w-5 fill-current" />
                INICIAR SERVIÇO
              </Button>
            ) : (
              <Button
                onClick={() => handleStatusChange("completed")}
                disabled={loading}
                className="w-full font-black h-14 text-base rounded-2xl bg-white text-green-600 hover:bg-white/90 shadow-xl shadow-black/20 gap-2"
              >
                <CheckCircle className="h-5 w-5" />
                FINALIZAR E RECEBER
              </Button>
            )}

            <Button
              variant="outline"
              onClick={sendWhatsApp}
              className="w-full font-black h-14 text-base rounded-2xl border-white/30 text-white hover:bg-white/10 bg-transparent gap-2"
            >
              <MessageCircle className="h-5 w-5" />
              WHATSAPP
            </Button>
          </div>
        </div>
      </CardContent>
    </Card>
  );
}
</file>

<file path="src/components/dashboard/NoShowPolicySettings.tsx">
'use client'

import React, { useState, useEffect } from 'react'
import { supabase } from '@/lib/supabase' // Ajuste o caminho do seu client do Supabase
import { useToast } from '@/components/ui/use-toast' // Ajuste conforme seu setup do Shadcn

// Componentes do Shadcn UI (Ajuste os caminhos de importação conforme sua estrutura)
import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/ui/card'
import { Switch } from '@/components/ui/switch'
import { Label } from '@/components/ui/label'
import { Input } from '@/components/ui/input'
import { Textarea } from '@/components/ui/textarea'
import { Button } from '@/components/ui/button'
import { Info, Save, ShieldCheck, AlertCircle } from 'lucide-react'

export default function NoShowPolicySettings() {
  const { toast } = useToast()

  // Estados do Formulário
  const [requireDeposit, setRequireDeposit] = useState(false)
  const [depositPercentage, setDepositPercentage] = useState<number>(30)
  const [cancellationWindow, setCancellationWindow] = useState<number>(2)
  const [refundPolicy, setRefundPolicy] = useState<string>(
    'Cancelamentos feitos com menos de 2 horas de antecedência não terão o sinal reembolsado.'
  )

  // Estados de UI
  const [isLoading, setIsLoading] = useState(true)
  const [isSaving, setIsSaving] = useState(false)

  // Valor base simulado para o resumo de impacto financeiro
  const baseServiceValue = 50 
  const calculatedDeposit = (baseServiceValue * (depositPercentage || 0)) / 100

  // 1. Carregar configurações atuais do Supabase
  useEffect(() => {
    async function fetchSettings() {
      try {
        setIsLoading(true)
        // Substitua 'barbershop_settings' pela sua tabela real e adicione o filtro do ID da barbearia
        const { data, error } = await supabase
          .from('barbershop_settings')
          .select('require_deposit, deposit_percentage, cancellation_window, refund_policy')
          .single()

        if (error) {
          // Ignora erro caso não tenha registro ainda (PGRST116 = zero rows)
          if (error.code !== 'PGRST116') throw error
        } else if (data) {
          setRequireDeposit(data.require_deposit)
          setDepositPercentage(data.deposit_percentage)
          setCancellationWindow(data.cancellation_window)
          setRefundPolicy(data.refund_policy)
        }
      } catch (error) {
        console.error('Erro ao buscar configurações:', error)
        toast({
          title: 'Erro ao carregar',
          description: 'Não foi possível carregar as políticas de No-Show.',
          variant: 'destructive',
        })
      } finally {
        setIsLoading(false)
      }
    }

    fetchSettings()
  }, [toast])

  // 2. Salvar configurações no Supabase
  const handleSave = async () => {
    try {
      setIsSaving(true)
      
      const payload = {
        require_deposit: requireDeposit,
        deposit_percentage: depositPercentage,
        cancellation_window: cancellationWindow,
        refund_policy: refundPolicy,
        updated_at: new Date().toISOString(),
      }

      // Substitua pela lógica real do seu backend (ex: usar upsert ou match com ID do user logado)
      const { error } = await supabase
        .from('barbershop_settings')
        .update(payload)
        .eq('id', 1) // ID mockado - substitua pelo ID da barbearia autenticada

      if (error) throw error

      toast({
        title: 'Sucesso!',
        description: 'Políticas de no-show atualizadas com sucesso.',
      })
    } catch (error) {
      console.error('Erro ao salvar:', error)
      toast({
        title: 'Erro ao salvar',
        description: 'Ocorreu um erro ao atualizar suas políticas.',
        variant: 'destructive',
      })
    } finally {
      setIsSaving(false)
    }
  }

  if (isLoading) {
    return (
      <div className="flex items-center justify-center h-48">
        <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-primary"></div>
      </div>
    )
  }

  return (
    <Card className="w-full max-w-3xl mx-auto border-border/60 shadow-sm">
      <CardHeader>
        <div className="flex items-center gap-2">
          <ShieldCheck className="h-6 w-6 text-primary" />
          <CardTitle className="text-xl">Proteção de Receita (No-Show)</CardTitle>
        </div>
        <CardDescription>
          Configure regras de pagamento antecipado para reduzir faltas e proteger seu faturamento.
        </CardDescription>
      </CardHeader>

      <CardContent className="space-y-6">
        {/* Switch Ativar/Desativar */}
        <div className="flex flex-row items-center justify-between rounded-lg border p-4 shadow-sm bg-card">
          <div className="space-y-0.5">
            <Label className="text-base font-semibold">Exigir Sinal Antecipado</Label>
            <p className="text-sm text-muted-foreground">
              Os clientes deverão pagar uma porcentagem para confirmar o agendamento online.
            </p>
          </div>
          <Switch 
            checked={requireDeposit} 
            onCheckedChange={setRequireDeposit} 
          />
        </div>

        {/* Formulário de Configuração (Desabilitado visualmente se o switch estiver desligado) */}
        <div className={`space-y-6 transition-opacity duration-300 ${!requireDeposit ? 'opacity-50 pointer-events-none' : 'opacity-100'}`}>
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="space-y-2">
              <Label htmlFor="depositPercentage">Porcentagem do Depósito (%)</Label>
              <div className="relative">
                <Input
                  id="depositPercentage"
                  type="number"
                  min={1}
                  max={100}
                  value={depositPercentage}
                  onChange={(e) => setDepositPercentage(Number(e.target.value))}
                  className="pl-3"
                />
              </div>
            </div>

            <div className="space-y-2">
              <Label htmlFor="cancellationWindow">Janela de Cancelamento Gratuito (Horas)</Label>
              <Input
                id="cancellationWindow"
                type="number"
                min={0}
                value={cancellationWindow}
                onChange={(e) => setCancellationWindow(Number(e.target.value))}
                placeholder="Ex: 2"
              />
            </div>
          </div>

          <div className="space-y-2">
            <Label htmlFor="refundPolicy">Termos da Política de Reembolso</Label>
            <Textarea
              id="refundPolicy"
              rows={3}
              value={refundPolicy}
              onChange={(e) => setRefundPolicy(e.target.value)}
              placeholder="Descreva as regras que o cliente verá ao agendar..."
              className="resize-none"
            />
            <p className="text-xs text-muted-foreground">
              Este texto será exibido na tela de checkout do aplicativo do cliente.
            </p>
          </div>

          {/* Resumo de Impacto Financeiro (Aparece apenas se ativado) */}
          {requireDeposit && (
            <div className="bg-primary/5 border border-primary/20 rounded-md p-4 flex gap-3">
              <Info className="h-5 w-5 text-primary flex-shrink-0 mt-0.5" />
              <div>
                <h4 className="text-sm font-semibold text-primary-foreground mb-1">Impacto Prático</h4>
                <p className="text-sm text-muted-foreground leading-relaxed">
                  Se um cliente agendar um corte de <strong>R$ {baseServiceValue.toFixed(2)}</strong>, ele pagará <strong>R$ {calculatedDeposit.toFixed(2)}</strong> agora para garantir o horário. Caso ele cancele faltando menos de <strong>{cancellationWindow} horas</strong> para o atendimento, você retém o valor do sinal.
                </p>
              </div>
            </div>
          )}
        </div>
        
        {/* Alerta de Desativação */}
        {!requireDeposit && (
          <div className="bg-muted p-4 rounded-md flex items-center gap-3 text-muted-foreground">
            <AlertCircle className="h-5 w-5" />
            <span className="text-sm">A proteção contra no-show está desativada. Os clientes podem agendar sem compromisso financeiro.</span>
          </div>
        )}
      </CardContent>

      <CardFooter className="flex justify-end pt-4 border-t border-border/50">
        <Button 
          onClick={handleSave} 
          disabled={isSaving || isLoading}
          className="w-full sm:w-auto"
        >
          {isSaving ? (
            <div className="animate-spin rounded-full h-4 w-4 border-b-2 border-white mr-2"></div>
          ) : (
            <Save className="h-4 w-4 mr-2" />
          )}
          {isSaving ? 'Salvando...' : 'Salvar Configurações'}
        </Button>
      </CardFooter>
    </Card>
  )
}
</file>

