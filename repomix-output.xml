<file path="src/lib/i18n.ts">
import i18n from "i18next";
import { initReactI18next } from "react-i18next";

import pt from "@/locales/pt.json";
import en from "@/locales/en.json";
import es from "@/locales/es.json";

export const SUPPORTED_LANGUAGES = ["pt", "en", "es"] as const;
export type SupportedLanguage = (typeof SUPPORTED_LANGUAGES)[number];

export const DEFAULT_LANGUAGE: SupportedLanguage = "pt";

function readStoredLanguage(): SupportedLanguage {
  if (typeof window === "undefined") return DEFAULT_LANGUAGE;
  try {
    const raw = window.localStorage.getItem("app_language");
    const normalized = raw?.slice(0, 2).toLowerCase();
    if (normalized && (SUPPORTED_LANGUAGES as readonly string[]).includes(normalized)) {
      return normalized as SupportedLanguage;
    }
  } catch {
    /* noop */
  }
  return DEFAULT_LANGUAGE;
}

if (!i18n.isInitialized) {
  // Inicialização SÍNCRONA — sem LanguageDetector, sem Suspense.
  // O hook useLocale ajusta o idioma depois com base em perfil/navegador.
  i18n.use(initReactI18next).init({
    resources: {
      pt: { translation: pt },
      en: { translation: en },
      es: { translation: es },
    },
    lng: readStoredLanguage(),
    fallbackLng: DEFAULT_LANGUAGE,
    supportedLngs: SUPPORTED_LANGUAGES as unknown as string[],
    nonExplicitSupportedLngs: true,
    load: "languageOnly",
    interpolation: { escapeValue: false },
    returnNull: false,
    returnEmptyString: false,
    react: {
      useSuspense: false,
    },
  });
}

export function setLanguage(lang: string) {
  const normalized = lang?.slice(0, 2).toLowerCase();
  const target = (SUPPORTED_LANGUAGES as readonly string[]).includes(normalized)
    ? (normalized as SupportedLanguage)
    : DEFAULT_LANGUAGE;
  if (i18n.language !== target) {
    i18n.changeLanguage(target);
  }
  try {
    if (typeof window !== "undefined") {
      window.localStorage.setItem("app_language", target);
    }
  } catch {
    /* noop */
  }
}

export function normalizeI18nKey(key: string) {
  return key
    .split(".")
    .map((part) => part.toLowerCase())
    .join(".");
}

export function translateKey(
  t: (key: string, options?: Record<string, unknown>) => unknown,
  key: string,
  options?: Record<string, unknown>,
) {
  const normalized = normalizeI18nKey(key);
  const translated = t(normalized, options);

  if (
    typeof translated === "string" &&
    translated.trim() &&
    translated !== normalized &&
    translated !== key
  ) {
    return translated;
  }

  if (normalized !== key) {
    const fallback = t(key, options);
    if (typeof fallback === "string" && fallback.trim() && fallback !== key) {
      return fallback;
    }
  }

  return "";
}

export default i18n;
</file>

<file path="src/lib/locale-format.ts">
/**
 * Formatação regional (moeda, data, hora) baseada nas preferências do usuário.
 * Fallback: Brasil (pt-BR / BRL / 24h).
 */

export interface LocalePreferences {
  language?: string;
  country?: string;
  currency?: string;
  timezone?: string;
  date_format?: string;
  time_format?: string;
}

const COUNTRY_TO_LOCALE: Record<string, string> = {
  BR: "pt-BR",
  US: "en-US",
  ES: "es-ES",
};

const COUNTRY_DEFAULTS: Record<
  string,
  { currency: string; timezone: string; date_format: string; time_format: "12h" | "24h" }
> = {
  BR: {
    currency: "BRL",
    timezone: "America/Sao_Paulo",
    date_format: "dd/MM/yyyy",
    time_format: "24h",
  },
  US: {
    currency: "USD",
    timezone: "America/New_York",
    date_format: "MM/dd/yyyy",
    time_format: "12h",
  },
  ES: { currency: "EUR", timezone: "Europe/Madrid", date_format: "dd/MM/yyyy", time_format: "24h" },
};

export function getCountryDefaults(country: string) {
  return COUNTRY_DEFAULTS[country] ?? COUNTRY_DEFAULTS.BR;
}

export function resolveLocale(prefs?: LocalePreferences | null): string {
  const country = prefs?.country ?? "BR";
  return COUNTRY_TO_LOCALE[country] ?? "pt-BR";
}

export function formatCurrency(
  value: number,
  prefs?: LocalePreferences | null,
  opts: Intl.NumberFormatOptions = {},
): string {
  const locale = resolveLocale(prefs);
  const currency = prefs?.currency ?? getCountryDefaults(prefs?.country ?? "BR").currency;
  return new Intl.NumberFormat(locale, {
    style: "currency",
    currency,
    maximumFractionDigits: 0,
    ...opts,
  }).format(Number.isFinite(value) ? value : 0);
}

export function formatDate(
  input: Date | string | number,
  prefs?: LocalePreferences | null,
): string {
  const locale = resolveLocale(prefs);
  const d = input instanceof Date ? input : new Date(input);
  return new Intl.DateTimeFormat(locale, {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    timeZone: prefs?.timezone ?? undefined,
  }).format(d);
}

export function formatTime(
  input: Date | string | number,
  prefs?: LocalePreferences | null,
): string {
  const locale = resolveLocale(prefs);
  const d = input instanceof Date ? input : new Date(input);
  const timeFormat = prefs?.time_format ?? getCountryDefaults(prefs?.country ?? "BR").time_format;
  return new Intl.DateTimeFormat(locale, {
    hour: "2-digit",
    minute: "2-digit",
    hour12: timeFormat === "12h",
    timeZone: prefs?.timezone ?? undefined,
  }).format(d);
}

export function formatDateTime(
  input: Date | string | number,
  prefs?: LocalePreferences | null,
): string {
  return `${formatDate(input, prefs)} ${formatTime(input, prefs)}`;
}
</file>

