<file path="src/routes/dashboard/_layout/index.tsx">
"use client";

import { createFileRoute, Link } from "@tanstack/react-router";
import type { ReactNode } from "react";
import { useTranslation } from "react-i18next";
import {
  TrendingUp,
  Package,
  DollarSign,
  Calendar,
  Zap,
  Star,
