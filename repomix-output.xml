<file path="src/components/dashboard/CashRegisterManager.tsx">
import React, { useState, useEffect } from 'react';
import { supabase } from '@/lib/supabase'; // Ajuste o caminho conforme o seu projeto
import { 
  Card, CardContent, CardHeader, CardTitle, CardDescription, CardFooter 
} from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Badge } from '@/components/ui/badge';
import { useToast } from '@/components/ui/use-toast';
import { 
  Dialog, DialogContent, DialogHeader, DialogTitle, DialogFooter, DialogDescription 
} from '@/components/ui/dialog';
import { 
  Wallet, ArrowDownToLine, ArrowUpFromLine, 
  Lock, Unlock, DollarSign, Activity, Loader2
} from 'lucide-react';

// Tipagem do Resumo do Caixa
interface CashSummary {
  initialBalance: number;
  totalEntries: number;
  totalBleeds: number;
  currentBalance: number;
}

export default function CashRegisterManager() {
  const { toast } = useToast();
  
  // Estados de Controle
  const [isLoading, setIsLoading] = useState(true);
  const [isActionLoading, setIsActionLoading] = useState(false);
  const [isOpen, setIsOpen] = useState(false);
  const [cashRegisterId, setCashRegisterId] = useState<string | null>(null);
  
  // Estados de Valores
  const [initialCash, setInitialCash] = useState<string>('');
  const [summary, setSummary] = useState<CashSummary>({
    initialBalance: 0,
    totalEntries: 0,
    totalBleeds: 0,
    currentBalance: 0,
  });

  // Estados dos Modais de Movimentação
  const [supplyModalOpen, setSupplyModalOpen] = useState(false);
  const [bleedModalOpen, setBleedModalOpen] = useState(false);
  const [transactionAmount, setTransactionAmount] = useState<string>('');
  const [transactionReason, setTransactionReason] = useState<string>('');

  // Formatação de Moeda BRL
  const formatCurrency = (value: number) => {
    return new Intl.NumberFormat('pt-BR', {
      style: 'currency',
      currency: 'BRL',
    }).format(value);
  };

  // Busca inicial de status do Caixa
  useEffect(() => {
    fetchCashRegisterStatus();
  }, []);

  const fetchCashRegisterStatus = async () => {
    setIsLoading(true);
    try {
      // Exemplo: Substitua pela sua RPC de buscar caixa atual ou query na tabela
      const { data, error } = await supabase.rpc('get_current_cash_register');
      
      if (error) throw error;

      if (data && data.is_open) {
        setIsOpen(true);
        setCashRegisterId(data.id);
        setSummary({
          initialBalance: data.initial_balance || 0,
          totalEntries: data.total_entries || 0,
          totalBleeds: data.total_bleeds || 0,
          currentBalance: data.current_balance || 0,
        });
      } else {
        setIsOpen(false);
      }
    } catch (error: any) {
      toast({
        title: "Erro ao buscar status",
        description: error.message,
        variant: "destructive",
      });
    } finally {
      setIsLoading(false);
    }
  };

  // Handler de Abertura de Caixa
  const handleOpenRegister = async () => {
    if (!initialCash || isNaN(Number(initialCash))) {
      toast({
        title: "Valor inválido",
        description: "Digite um saldo inicial válido em dinheiro.",
        variant: "destructive",
      });
      return;
    }

    setIsActionLoading(true);
    try {
      const { error } = await supabase.rpc('open_cash_register', {
        p_initial_balance: parseFloat(initialCash)
      });

      if (error) throw error;

      toast({
        title: "Caixa aberto com sucesso!",
        description: `Saldo inicial: ${formatCurrency(parseFloat(initialCash))}`,
      });
      
      setInitialCash('');
      fetchCashRegisterStatus(); // Atualiza a tela
    } catch (error: any) {
      toast({
        title: "Erro ao abrir o caixa",
        description: error.message,
        variant: "destructive",
      });
    } finally {
      setIsActionLoading(false);
    }
  };

  // Handler genérico de Movimentação (Suprimento / Sangria)
  const handleMovement = async (type: 'supply' | 'bleed') => {
    if (!transactionAmount || isNaN(Number(transactionAmount))) {
      toast({
        title: "Valor inválido",
        description: "Digite um valor válido para a movimentação.",
        variant: "destructive",
      });
      return;
    }

    setIsActionLoading(true);
    try {
      // Ajuste o nome da sua RPC de acordo com o seu backend
      const rpcName = type === 'supply' ? 'register_cash_supply' : 'register_cash_bleed';
      
      const { error } = await supabase.rpc(rpcName, {
        p_cash_register_id: cashRegisterId,
        p_amount: parseFloat(transactionAmount),
        p_reason: transactionReason || (type === 'supply' ? 'Suprimento Manual' : 'Sangria Manual'),
      });

      if (error) throw error;

      toast({
        title: type === 'supply' ? "Suprimento registrado!" : "Sangria registrada!",
        description: `Valor: ${formatCurrency(parseFloat(transactionAmount))}`,
      });

      // Fechar modal e limpar campos
      setSupplyModalOpen(false);
      setBleedModalOpen(false);
      setTransactionAmount('');
      setTransactionReason('');
      
      fetchCashRegisterStatus(); // Atualiza os saldos visuais
    } catch (error: any) {
      toast({
        title: "Erro na movimentação",
        description: error.message,
        variant: "destructive",
      });
    } finally {
      setIsActionLoading(false);
    }
  };

  if (isLoading) {
    return (
      <div className="flex justify-center items-center h-64 w-full">
        <Loader2 className="w-8 h-8 animate-spin text-muted-foreground" />
      </div>
    );
  }

  // --- RENDERIZAÇÃO: CAIXA FECHADO ---
  if (!isOpen) {
    return (
      <Card className="max-w-md mx-auto mt-10 border-dashed border-2">
        <CardHeader className="text-center pb-2">
          <div className="mx-auto bg-muted p-3 rounded-full w-fit mb-4">
            <Lock className="w-8 h-8 text-muted-foreground" />
          </div>
          <CardTitle className="text-2xl">Caixa Fechado</CardTitle>
          <CardDescription>
            Inicie o turno abrindo o caixa operacional.
          </CardDescription>
        </CardHeader>
        <CardContent className="space-y-4 pt-4">
          <div className="space-y-2">
            <Label htmlFor="initialBalance">Saldo Inicial em Dinheiro (Fundo de Troco)</Label>
            <div className="relative">
              <DollarSign className="absolute left-3 top-2.5 h-4 w-4 text-muted-foreground" />
              <Input 
                id="initialBalance"
                type="number"
                placeholder="0.00"
                className="pl-9"
                value={initialCash}
                onChange={(e) => setInitialCash(e.target.value)}
              />
            </div>
          </div>
        </CardContent>
        <CardFooter>
          <Button 
            className="w-full font-semibold" 
            size="lg" 
            onClick={handleOpenRegister}
            disabled={isActionLoading}
          >
            {isActionLoading ? <Loader2 className="w-4 h-4 mr-2 animate-spin" /> : <Unlock className="w-4 h-4 mr-2" />}
            Abrir Caixa
          </Button>
        </CardFooter>
      </Card>
    );
  }

  // --- RENDERIZAÇÃO: CAIXA ABERTO ---
  return (
    <div className="space-y-6">
      {/* HEADER DE STATUS E AÇÕES RÁPIDAS */}
      <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-card p-4 rounded-xl border shadow-sm">
        <div className="flex items-center gap-3">
          <div className="bg-primary/10 p-2 rounded-lg">
            <Activity className="w-6 h-6 text-primary" />
          </div>
          <div>
            <h2 className="text-xl font-bold flex items-center gap-2">
              Caixa Operacional
              <Badge variant="default" className="bg-emerald-500 hover:bg-emerald-600">ABERTO</Badge>
            </h2>
            <p className="text-sm text-muted-foreground">O caixa está recebendo movimentações.</p>
          </div>
        </div>

        <div className="flex gap-2 w-full md:w-auto">
          {/* MODAL: REGISTRAR SUPRIMENTO */}
          <Dialog open={supplyModalOpen} onOpenChange={setSupplyModalOpen}>
            <DialogTrigger asChild>
              <Button variant="outline" className="flex-1 md:flex-none border-blue-200 hover:bg-blue-50 text-blue-700">
                <ArrowUpFromLine className="w-4 h-4 mr-2" />
                Suprimento
              </Button>
            </DialogTrigger>
            <DialogContent>
              <DialogHeader>
                <DialogTitle>Registrar Suprimento</DialogTitle>
                <DialogDescription>Adicione dinheiro extra ao caixa (Ex: reforço de troco).</DialogDescription>
              </DialogHeader>
              <div className="space-y-4 py-4">
                <div className="space-y-2">
                  <Label>Valor do Suprimento (R$)</Label>
                  <Input type="number" value={transactionAmount} onChange={(e) => setTransactionAmount(e.target.value)} />
                </div>
                <div className="space-y-2">
                  <Label>Motivo / Observação</Label>
                  <Input placeholder="Ex: Reforço de troco da gaveta" value={transactionReason} onChange={(e) => setTransactionReason(e.target.value)} />
                </div>
              </div>
              <DialogFooter>
                <Button variant="outline" onClick={() => setSupplyModalOpen(false)}>Cancelar</Button>
                <Button onClick={() => handleMovement('supply')} disabled={isActionLoading}>Confirmar Suprimento</Button>
              </DialogFooter>
            </DialogContent>
          </Dialog>

          {/* MODAL: REGISTRAR SANGRIA */}
          <Dialog open={bleedModalOpen} onOpenChange={setBleedModalOpen}>
            <DialogTrigger asChild>
              <Button variant="outline" className="flex-1 md:flex-none border-red-200 hover:bg-red-50 text-red-700">
                <ArrowDownToLine className="w-4 h-4 mr-2" />
                Sangria
              </Button>
            </DialogTrigger>
            <DialogContent>
              <DialogHeader>
                <DialogTitle>Registrar Sangria</DialogTitle>
                <DialogDescription>Retire dinheiro do caixa (Ex: pagamento de despesas, malote).</DialogDescription>
              </DialogHeader>
              <div className="space-y-4 py-4">
                <div className="space-y-2">
                  <Label>Valor da Sangria (R$)</Label>
                  <Input type="number" value={transactionAmount} onChange={(e) => setTransactionAmount(e.target.value)} />
                </div>
                <div className="space-y-2">
                  <Label>Motivo / Observação</Label>
                  <Input placeholder="Ex: Pagamento fornecedor de bebidas" value={transactionReason} onChange={(e) => setTransactionReason(e.target.value)} />
                </div>
              </div>
              <DialogFooter>
                <Button variant="outline" onClick={() => setBleedModalOpen(false)}>Cancelar</Button>
                <Button variant="destructive" onClick={() => handleMovement('bleed')} disabled={isActionLoading}>Confirmar Sangria</Button>
              </DialogFooter>
            </DialogContent>
          </Dialog>
        </div>
      </div>

      {/* GRID DE RESUMO VISUAL DINÂMICO */}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <Card>
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-sm font-medium text-muted-foreground">Saldo Inicial</CardTitle>
            <Wallet className="w-4 h-4 text-muted-foreground" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{formatCurrency(summary.initialBalance)}</div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-sm font-medium text-muted-foreground">Total de Entradas</CardTitle>
            <ArrowUpFromLine className="w-4 h-4 text-blue-500" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold text-blue-600">{formatCurrency(summary.totalEntries)}</div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-sm font-medium text-muted-foreground">Total de Sangrias</CardTitle>
            <ArrowDownToLine className="w-4 h-4 text-red-500" />
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold text-red-600">-{formatCurrency(summary.totalBleeds)}</div>
          </CardContent>
        </Card>

        <Card className="bg-primary text-primary-foreground border-primary">
          <CardHeader className="flex flex-row items-center justify-between pb-2">
            <CardTitle className="text-sm font-medium text-primary-foreground/80">Saldo Atual Estimado</CardTitle>
            <DollarSign className="w-4 h-4" />
          </CardHeader>
          <CardContent>
            <div className="text-3xl font-bold">{formatCurrency(summary.currentBalance)}</div>
            <p className="text-xs text-primary-foreground/70 mt-1">Dinheiro em gaveta</p>
          </CardContent>
        </Card>
      </div>
    </div>
  );
}
</file>

<file path="src/components/dashboard/CheckoutDialog.tsx">
import { useState, useEffect } from "react";
import { Button } from "@/components/ui/button";
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { RadioGroup, RadioGroupItem } from "@/components/ui/radio-group";
import { supabase } from "@/integrations/supabase/client";
import { toast } from "sonner";
import {
  CreditCard,
  DollarSign,
  Wallet,
  Loader2,
  Plus,
  Minus,
  Package,
  X,
  Printer,
} from "lucide-react";
import { printReceipt } from "@/lib/print-receipt";

interface CheckoutDialogProps {
  appointment: any;
  open: boolean;
  onOpenChange: (open: boolean) => void;
  onSuccess: () => void;
}

interface CartProduct {
  id: string;
  name: string;
  price: number;
  stock: number;
  quantity: number;
}

export function CheckoutDialog({
  appointment,
  open,
  onOpenChange,
  onSuccess,
}: CheckoutDialogProps) {
  const servicePrice = Number(appointment?.service?.price) || 0;
  const [paymentMethod, setPaymentMethod] = useState("money");
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [products, setProducts] = useState<any[]>([]);
  const [cart, setCart] = useState<CartProduct[]>([]);
  const [showProducts, setShowProducts] = useState(false);

  useEffect(() => {
    if (!open) return;
    setCart([]);
    setShowProducts(false);
    (async () => {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) return;
      const { data } = await supabase
        .from("products")
        .select("id, name, selling_price, sale_price, current_stock")
        .eq("user_id", user.id)
        .gt("current_stock", 0)
        .order("name");
      setProducts(data || []);
    })();
  }, [open]);

  const productsTotal = cart.reduce((acc, p) => acc + p.price * p.quantity, 0);
  const total = servicePrice + productsTotal;

  const addToCart = (product: any) => {
    const price = Number(product.selling_price ?? product.sale_price) || 0;
    setCart((prev) => {
      const existing = prev.find((p) => p.id === product.id);
      if (existing) {
        if (existing.quantity >= product.current_stock) {
          toast.error("Estoque insuficiente");
          return prev;
        }
        return prev.map((p) => (p.id === product.id ? { ...p, quantity: p.quantity + 1 } : p));
      }
      return [
        ...prev,
        { id: product.id, name: product.name, price, stock: product.current_stock, quantity: 1 },
      ];
    });
  };

  const updateQty = (id: string, delta: number) => {
    setCart((prev) =>
      prev
        .map((p) => {
          if (p.id !== id) return p;
          const next = p.quantity + delta;
          if (next > p.stock) {
            toast.error("Estoque insuficiente");
            return p;
          }
          return { ...p, quantity: next };
        })
        .filter((p) => p.quantity > 0),
    );
  };

  const handleCheckout = async () => {
    setIsSubmitting(true);
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) throw new Error("Usuário não autenticado");

      // 1. Mark appointment as completed
      const { error: aptError } = await supabase
        .from("appointments")
        .update({ status: "completed" })
        .eq("id", appointment.id);
      if (aptError) throw aptError;

      // 2. Service revenue
      const { error: finError } = await supabase.from("financial_records").insert({
        user_id: user.id,
        amount: servicePrice,
        type: "income",
        category: "service",
        description: `Atendimento: ${appointment.client?.name || appointment.customer_name || "Cliente Avulso"} - ${appointment.service?.name}`,
        appointment_id: appointment.id,
        date: new Date().toISOString(),
      });
      if (finError) throw finError;

      // 3. Products: financial record + stock decrement
      for (const item of cart) {
        await supabase.from("financial_records").insert({
          user_id: user.id,
          amount: item.price * item.quantity,
          type: "income",
          category: "product",
          description: `Venda de produto: ${item.name} x${item.quantity}`,
          appointment_id: appointment.id,
          date: new Date().toISOString(),
        });

        await supabase
          .from("products")
          .update({ current_stock: item.stock - item.quantity })
          .eq("id", item.id);
      }

      // 4. Update client stats
      if (appointment.client_id) {
        const { data: client } = await supabase
          .from("clients")
          .select("total_spent")
          .eq("id", appointment.client_id)
          .single();
        const currentTotal = Number(client?.total_spent) || 0;
        await supabase
          .from("clients")
          .update({
            last_visit: new Date().toISOString(),
            total_spent: currentTotal + total,
          })
          .eq("id", appointment.client_id);
      }

      toast.success("Atendimento finalizado!");
      try {
        printReceipt({
          clientName: appointment.client?.name || appointment.customer_name || "Cliente",
          serviceName: appointment.service?.name,
          servicePrice,
          products: cart.map((c) => ({ name: c.name, quantity: c.quantity, price: c.price })),
          total,
          paymentMethod:
            paymentMethod === "money" ? "Dinheiro" : paymentMethod === "card" ? "Cartão" : "Pix",
        });
      } catch (receiptError) {
        console.warn("Não foi possível imprimir o recibo:", receiptError);
      }
      onSuccess();
      onOpenChange(false);
    } catch (error: any) {
      console.error("Checkout error:", error);
      toast.error(error.message || "Erro ao finalizar atendimento");
    } finally {
      setIsSubmitting(false);
    }
  };

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-[480px] p-0 overflow-hidden border-none rounded-3xl max-h-[90vh] overflow-y-auto">
        <DialogHeader className="p-6 bg-primary text-primary-foreground">
          <DialogTitle className="text-2xl font-black uppercase tracking-tight italic">
            Finalizar Atendimento
          </DialogTitle>
          <p className="text-primary-foreground/80 font-medium">
            Confirme os detalhes do pagamento.
          </p>
        </DialogHeader>

        <div className="p-6 space-y-5">
          {/* Service line */}
          <div className="flex items-center justify-between p-3 rounded-xl bg-secondary/50">
            <div>
              <p className="text-[10px] font-black uppercase tracking-widest text-muted-foreground">
                Serviço
              </p>
              <p className="font-bold">{appointment?.service?.name || "—"}</p>
            </div>
            <p className="font-black text-lg">R$ {servicePrice.toFixed(2)}</p>
          </div>

          {/* Products in cart */}
          {cart.length > 0 && (
            <div className="space-y-2">
              <Label className="text-sm font-black uppercase tracking-widest opacity-70">
                Produtos
              </Label>
              {cart.map((item) => (
                <div
                  key={item.id}
                  className="flex items-center justify-between p-3 rounded-xl bg-secondary/50"
                >
                  <div className="flex-1">
                    <p className="font-bold text-sm">{item.name}</p>
                    <p className="text-xs text-muted-foreground">R$ {item.price.toFixed(2)} un.</p>
                  </div>
                  <div className="flex items-center gap-2">
                    <Button
                      type="button"
                      size="icon"
                      variant="outline"
                      aria-label={`Diminuir quantidade de ${item.name}`}
                      className="h-8 w-8 rounded-lg"
                      onClick={() => updateQty(item.id, -1)}
                    >
                      <Minus className="h-3 w-3" aria-hidden="true" />
                    </Button>
                    <span className="w-6 text-center font-black" aria-live="polite">
                      {item.quantity}
                    </span>
                    <Button
                      type="button"
                      size="icon"
                      variant="outline"
                      aria-label={`Aumentar quantidade de ${item.name}`}
                      className="h-8 w-8 rounded-lg"
                      onClick={() => updateQty(item.id, 1)}
                    >
                      <Plus className="h-3 w-3" aria-hidden="true" />
                    </Button>
                  </div>
                </div>
              ))}
            </div>
          )}

          {/* Add product */}
          {products.length > 0 && (
            <div>
              <Button
                type="button"
                variant="outline"
                className="w-full h-11 rounded-xl gap-2 font-black uppercase text-xs"
                onClick={() => setShowProducts((v) => !v)}
              >
                {showProducts ? <X className="h-4 w-4" /> : <Package className="h-4 w-4" />}
                {showProducts ? "Fechar Produtos" : "Adicionar Produto"}
              </Button>
              {showProducts && (
                <div className="mt-2 max-h-40 overflow-y-auto border border-border rounded-xl divide-y">
                  {products.map((p) => {
                    const price = Number(p.selling_price ?? p.sale_price) || 0;
                    return (
                      <button
                        key={p.id}
                        type="button"
                        onClick={() => addToCart(p)}
                        className="w-full flex items-center justify-between p-3 hover:bg-secondary/50 text-left"
                      >
                        <div>
                          <p className="font-bold text-sm">{p.name}</p>
                          <p className="text-xs text-muted-foreground">
                            Estoque: {p.current_stock}
                          </p>
                        </div>
                        <p className="font-black text-sm">R$ {price.toFixed(2)}</p>
                      </button>
                    );
                  })}
                </div>
              )}
            </div>
          )}

          {/* Total */}
          <div className="flex items-center justify-between p-4 rounded-2xl bg-primary/5 border-2 border-primary/20">
            <span className="font-black uppercase tracking-widest text-sm">Total</span>
            <span className="text-3xl font-black italic">R$ {total.toFixed(2)}</span>
          </div>

          {/* Payment method */}
          <div className="space-y-3">
            <Label className="text-sm font-black uppercase tracking-widest opacity-70">
              Forma de Pagamento
            </Label>
            <RadioGroup
              value={paymentMethod}
              onValueChange={setPaymentMethod}
              className="grid grid-cols-1 sm:grid-cols-3 gap-3"
            >
              <div>
                <RadioGroupItem value="money" id="money" className="peer sr-only" />
                <Label
                  htmlFor="money"
                  className="flex flex-col items-center rounded-2xl border-2 border-muted bg-popover p-4 hover:bg-accent peer-data-[state=checked]:border-primary peer-data-[state=checked]:bg-primary/5"
                >
                  <DollarSign className="mb-2 h-6 w-6" />
                  <span className="text-[10px] font-black uppercase">Dinheiro</span>
                </Label>
              </div>
              <div>
                <RadioGroupItem value="pix" id="pix" className="peer sr-only" />
                <Label
                  htmlFor="pix"
                  className="flex flex-col items-center rounded-2xl border-2 border-muted bg-popover p-4 hover:bg-accent peer-data-[state=checked]:border-primary peer-data-[state=checked]:bg-primary/5"
                >
                  <Wallet className="mb-2 h-6 w-6" />
                  <span className="text-[10px] font-black uppercase">PIX</span>
                </Label>
              </div>
              <div>
                <RadioGroupItem value="card" id="card" className="peer sr-only" />
                <Label
                  htmlFor="card"
                  className="flex flex-col items-center rounded-2xl border-2 border-muted bg-popover p-4 hover:bg-accent peer-data-[state=checked]:border-primary peer-data-[state=checked]:bg-primary/5"
                >
                  <CreditCard className="mb-2 h-6 w-6" />
                  <span className="text-[10px] font-black uppercase">Cartão</span>
                </Label>
              </div>
            </RadioGroup>
          </div>

          <Button
            className="w-full h-16 text-xl font-black uppercase tracking-tight rounded-2xl shadow-xl shadow-primary/20"
            onClick={handleCheckout}
            disabled={isSubmitting}
          >
            {isSubmitting ? <Loader2 className="h-6 w-6 animate-spin" /> : "CONCLUIR E RECEBER"}
          </Button>
        </div>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/components/dashboard/ClientForm.tsx">
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import * as z from "zod";
import { useState } from "react";
import { Button } from "@/components/ui/button";
import {
  Form,
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from "@/components/ui/form";
import { Input } from "@/components/ui/input";
import { Textarea } from "@/components/ui/textarea";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { supabase } from "@/integrations/supabase/client";
import { toast } from "sonner";
import { Loader2, Upload, User } from "lucide-react";

const clientSchema = z.object({
  name: z.string().min(2, "Nome deve ter pelo menos 2 caracteres"),
  phone: z.string().optional(),
  birthday: z.string().optional(),
  instagram: z.string().optional(),
  notes: z.string().optional(),
});

type ClientFormValues = z.infer<typeof clientSchema>;

interface ClientFormProps {
  client?: any;
  onSuccess: () => void;
  onCancel: () => void;
}

export function ClientForm({ client, onSuccess, onCancel }: ClientFormProps) {
  const isEditing = !!client;
  const [photoUrl, setPhotoUrl] = useState<string | null>(client?.photo_url || null);
  const [uploading, setUploading] = useState(false);

  const form = useForm<ClientFormValues>({
    resolver: zodResolver(clientSchema),
    defaultValues: {
      name: client?.name || "",
      phone: client?.phone || "",
      birthday: client?.birthday || "",
      instagram: client?.instagram || "",
      notes: client?.notes || "",
    },
  });

  const handlePhotoUpload = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    try {
      setUploading(true);
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) throw new Error("Usuário não autenticado");

      const ext = file.name.split(".").pop();
      const path = `${user.id}/${crypto.randomUUID()}.${ext}`;

      const { error: uploadError } = await supabase.storage
        .from("client-photos")
        .upload(path, file, { upsert: true });
      if (uploadError) throw uploadError;

      const { data: signed } = await supabase.storage
        .from("client-photos")
        .createSignedUrl(path, 60 * 60 * 24 * 365);

      setPhotoUrl(signed?.signedUrl || path);
      toast.success("Foto enviada");
    } catch (err: any) {
      console.error(err);
      toast.error(err.message || "Erro ao enviar foto");
    } finally {
      setUploading(false);
    }
  };

  const onSubmit = async (values: ClientFormValues) => {
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) throw new Error("Usuário não autenticado");

      const payload = {
        ...values,
        user_id: user.id,
        birthday: values.birthday || null,
        photo_url: photoUrl,
        updated_at: new Date().toISOString(),
      };

      if (isEditing) {
        const { error } = await supabase.from("clients").update(payload).eq("id", client.id);
        if (error) throw error;
        toast.success("Cliente atualizado com sucesso");
      } else {
        const { error } = await supabase.from("clients").insert(payload);
        if (error) throw error;
        toast.success("Cliente cadastrado com sucesso");
      }
      onSuccess();
    } catch (error: any) {
      console.error("Error saving client:", error);
      toast.error(error.message || "Erro ao salvar cliente");
    }
  };

  return (
    <Form {...form}>
      <form onSubmit={form.handleSubmit(onSubmit)} className="space-y-6">
        <div className="flex items-center gap-4">
          <Avatar className="h-20 w-20 border-2 border-border">
            {photoUrl && <AvatarImage src={photoUrl} alt="Foto" />}
            <AvatarFallback className="bg-secondary">
              <User className="h-8 w-8 text-muted-foreground" />
            </AvatarFallback>
          </Avatar>
          <label className="cursor-pointer">
            <input
              type="file"
              accept="image/*"
              className="hidden"
              onChange={handlePhotoUpload}
              disabled={uploading}
            />
            <div className="inline-flex items-center gap-2 h-11 px-4 rounded-xl border border-border bg-background hover:bg-secondary font-black uppercase text-xs tracking-widest">
              {uploading ? (
                <Loader2 className="h-4 w-4 animate-spin" />
              ) : (
                <Upload className="h-4 w-4" />
              )}
              {photoUrl ? "Trocar Foto" : "Adicionar Foto"}
            </div>
          </label>
        </div>

        <FormField
          control={form.control}
          name="name"
          render={({ field }) => (
            <FormItem>
              <FormLabel className="text-sm font-black uppercase tracking-widest">
                Nome Completo
              </FormLabel>
              <FormControl>
                <Input placeholder="Ex: João Silva" {...field} className="h-12 text-lg font-bold" />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />

        <div className="grid grid-cols-2 gap-4">
          <FormField
            control={form.control}
            name="phone"
            render={({ field }) => (
              <FormItem>
                <FormLabel className="text-sm font-black uppercase tracking-widest">
                  WhatsApp
                </FormLabel>
                <FormControl>
                  <Input
                    placeholder="(00) 00000-0000"
                    {...field}
                    className="h-12 text-lg font-bold"
                  />
                </FormControl>
                <FormMessage />
              </FormItem>
            )}
          />

          <FormField
            control={form.control}
            name="birthday"
            render={({ field }) => (
              <FormItem>
                <FormLabel className="text-sm font-black uppercase tracking-widest">
                  Aniversário
                </FormLabel>
                <FormControl>
                  <Input type="date" {...field} className="h-12 text-lg font-bold" />
                </FormControl>
                <FormMessage />
              </FormItem>
            )}
          />
        </div>

        <FormField
          control={form.control}
          name="instagram"
          render={({ field }) => (
            <FormItem>
              <FormLabel className="text-sm font-black uppercase tracking-widest">
                Instagram
              </FormLabel>
              <FormControl>
                <Input placeholder="@usuario" {...field} className="h-12 text-lg font-bold" />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />

        <FormField
          control={form.control}
          name="notes"
          render={({ field }) => (
            <FormItem>
              <FormLabel className="text-sm font-black uppercase tracking-widest">
                Observações
              </FormLabel>
              <FormControl>
                <Textarea
                  placeholder="Ex: Prefere corte baixo, alérgico a tal produto..."
                  {...field}
                  className="min-h-[80px] text-base font-medium"
                />
              </FormControl>
              <FormMessage />
            </FormItem>
          )}
        />

        <div className="flex gap-3 pt-4">
          <Button
            type="button"
            variant="outline"
            onClick={onCancel}
            className="flex-1 h-14 font-black uppercase tracking-widest rounded-xl"
          >
            Cancelar
          </Button>
          <Button
            type="submit"
            disabled={form.formState.isSubmitting}
            className="flex-1 h-14 font-black uppercase tracking-widest rounded-xl shadow-lg shadow-primary/20"
          >
            {form.formState.isSubmitting ? (
              <Loader2 className="h-5 w-5 animate-spin" />
            ) : isEditing ? (
              "SALVAR"
            ) : (
              "CADASTRAR"
            )}
          </Button>
        </div>
      </form>
    </Form>
  );
}
</file>

<file path="src/components/dashboard/FinanceForm.tsx">
import { useEffect, useMemo, useState } from "react";
import { useForm } from "react-hook-form";
import { zodResolver } from "@hookform/resolvers/zod";
import * as z from "zod";
import { Button } from "@/components/ui/button";
import {
  Form,
  FormControl,
  FormField,
  FormItem,
  FormLabel,
  FormMessage,
} from "@/components/ui/form";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Textarea } from "@/components/ui/textarea";
import { supabase } from "@/integrations/supabase/client";
import { toast } from "sonner";
import { Loader2, Plus, Minus, Trash2, Package, Search } from "lucide-react";

const financeSchema = z.object({
  amount: z.coerce.number().min(0.01, "Valor deve ser maior que zero"),
  type: z.enum(["income", "expense"]),
  category: z.string().min(1, "Selecione uma categoria"),
  description: z.string().min(1, "Descrição é obrigatória"),
  date: z.string().min(1, "Selecione uma data"),
});

type FinanceFormValues = z.infer<typeof financeSchema>;

interface FinanceFormProps {
  onSuccess: () => void;
  onCancel: () => void;
}

type Origin = "service" | "product" | "other";

interface ProductRow {
  id: string;
  name: string;
  current_stock: number;
  min_stock: number;
  sale_price: number | null;
  selling_price: number | null;
  cost_price: number | null;
  purchase_price: number | null;
}

interface CartItem {
  productId: string;
  name: string;
  quantity: number;
  unitPrice: number;
  stock: number;
  minStock: number;
  cost: number;
}

const priceOf = (p: ProductRow) => Number(p.selling_price ?? p.sale_price ?? 0) || 0;
const costOf = (p: ProductRow) => Number(p.cost_price ?? p.purchase_price ?? 0) || 0;

export function FinanceForm({ onSuccess, onCancel }: FinanceFormProps) {
  const [origin, setOrigin] = useState<Origin>("service");
  const [products, setProducts] = useState<ProductRow[]>([]);
  const [cart, setCart] = useState<CartItem[]>([]);
  const [search, setSearch] = useState("");
  const [paymentMethod, setPaymentMethod] = useState("pix");
  const [productNote, setProductNote] = useState("");
  const [productDate, setProductDate] = useState(new Date().toISOString().split("T")[0]);
  const [submittingProducts, setSubmittingProducts] = useState(false);

  const form = useForm<FinanceFormValues>({
    resolver: zodResolver(financeSchema),
    defaultValues: {
      amount: 0,
      type: "income",
      category: "service",
      description: "",
      date: new Date().toISOString().split("T")[0],
    },
  });

  // Load products for product-sale flow (lazy on demand)
  useEffect(() => {
    if (origin !== "product" || products.length > 0) return;
    (async () => {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) return;
      const { data } = await supabase
        .from("products")
        .select(
          "id, name, current_stock, min_stock, sale_price, selling_price, cost_price, purchase_price",
        )
        .eq("user_id", user.id)
        .order("name");
      setProducts((data as ProductRow[]) || []);
    })();
  }, [origin, products.length]);

  const filteredProducts = useMemo(() => {
    const q = search.trim().toLowerCase();
    if (!q) return products.slice(0, 8);
    return products.filter((p) => p.name.toLowerCase().includes(q)).slice(0, 8);
  }, [products, search]);

  const cartTotal = useMemo(
    () => cart.reduce((acc, i) => acc + i.unitPrice * i.quantity, 0),
    [cart],
  );

  const addToCart = (p: ProductRow) => {
    setCart((prev) => {
      const existing = prev.find((i) => i.productId === p.id);
      if (existing) {
        if (existing.quantity + 1 > p.current_stock) {
          toast.error(`Estoque insuficiente. Disponível: ${p.current_stock}`);
          return prev;
        }
        return prev.map((i) => (i.productId === p.id ? { ...i, quantity: i.quantity + 1 } : i));
      }
      if (p.current_stock < 1) {
        toast.error("Estoque insuficiente. Disponível: 0");
        return prev;
      }
      return [
        ...prev,
        {
          productId: p.id,
          name: p.name,
          quantity: 1,
          unitPrice: priceOf(p),
          stock: p.current_stock,
          minStock: p.min_stock,
          cost: costOf(p),
        },
      ];
    });
    setSearch("");
  };

  const updateQty = (id: string, delta: number) => {
    setCart((prev) =>
      prev
        .map((i) => {
          if (i.productId !== id) return i;
          const next = i.quantity + delta;
          if (next > i.stock) {
            toast.error(`Estoque insuficiente. Disponível: ${i.stock}`);
            return i;
          }
          return { ...i, quantity: next };
        })
        .filter((i) => i.quantity > 0),
    );
  };

  const updatePrice = (id: string, value: number) => {
    setCart((prev) =>
      prev.map((i) => (i.productId === id ? { ...i, unitPrice: Math.max(0, value) } : i)),
    );
  };

  const removeItem = (id: string) => {
    setCart((prev) => prev.filter((i) => i.productId !== id));
  };

  const handleSellProducts = async () => {
    if (cart.length === 0) {
      toast.error("Adicione ao menos um produto");
      return;
    }
    // Validate stock again
    for (const item of cart) {
      if (item.quantity > item.stock) {
        toast.error(`Estoque insuficiente para ${item.name}. Disponível: ${item.stock}`);
        return;
      }
    }
    setSubmittingProducts(true);
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) throw new Error("Usuário não autenticado");

      const total = cartTotal;
      const summary = cart.map((i) => `${i.name} x${i.quantity}`).join(", ");
      const paymentLabel =
        paymentMethod === "pix"
          ? "PIX"
          : paymentMethod === "money"
            ? "Dinheiro"
            : paymentMethod === "card"
              ? "Cartão"
              : "Outro";
      const description =
        `Venda de Produto — ${summary} · Pagamento: ${paymentLabel}` +
        (productNote.trim() ? ` · Obs: ${productNote.trim()}` : "");

      // 1) Single financial record
      const { error: finErr } = await supabase.from("financial_records").insert({
        user_id: user.id,
        type: "income",
        category: "product",
        amount: total,
        description,
        date: productDate,
      });
      if (finErr) throw finErr;

      // 2) Decrement stock per product
      const lowStockWarns: string[] = [];
      const lastUnitWarns: string[] = [];
      for (const item of cart) {
        const newStock = item.stock - item.quantity;
        const { error: updErr } = await supabase
          .from("products")
          .update({ current_stock: newStock })
          .eq("id", item.productId)
          .eq("user_id", user.id);
        if (updErr) throw updErr;
        if (newStock === 0) lastUnitWarns.push(item.name);
        else if (newStock <= item.minStock) lowStockWarns.push(item.name);
      }

      toast.success("Venda registrada e estoque atualizado");
      lowStockWarns.forEach((n) => toast.warning(`⚠ ${n} atingiu o estoque mínimo.`));
      lastUnitWarns.forEach((n) =>
        toast.warning(`⚠ Última unidade de ${n} vendida. Considere repor.`),
      );
      onSuccess();
    } catch (error: any) {
      toast.error(error.message || "Erro ao registrar venda");
    } finally {
      setSubmittingProducts(false);
    }
  };

  const onSubmit = async (values: FinanceFormValues) => {
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) throw new Error("Usuário não autenticado");

      const { error } = await supabase
        .from("financial_records")
        .insert({ ...values, user_id: user.id });

      if (error) throw error;
      toast.success("Lançamento registrado!");
      onSuccess();
    } catch (error: any) {
      toast.error(error.message || "Erro ao registrar lançamento");
    }
  };

  return (
    <div className="space-y-5">
      {/* Origem da Receita */}
      <div className="space-y-2">
        <Label className="text-sm font-black uppercase tracking-widest">Origem da Receita</Label>
        <Select
          value={origin}
          onValueChange={(v: Origin) => {
            setOrigin(v);
            if (v === "service") {
              form.setValue("type", "income");
              form.setValue("category", "service");
            } else if (v === "other") {
              form.setValue("type", "income");
              form.setValue("category", "other");
            }
          }}
        >
          <SelectTrigger className="h-12 text-lg font-bold">
            <SelectValue />
          </SelectTrigger>
          <SelectContent>
            <SelectItem value="service" className="font-bold">
              Serviço
            </SelectItem>
            <SelectItem value="product" className="font-bold">
              Produto
            </SelectItem>
            <SelectItem value="other" className="font-bold">
              Outra Receita / Despesa
            </SelectItem>
          </SelectContent>
        </Select>
      </div>

      {origin === "product" ? (
        <div className="space-y-4">
          {/* Search / autocomplete */}
          <div className="space-y-2">
            <Label className="text-sm font-black uppercase tracking-widest">Produto</Label>
            <div className="relative">
              <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
              <Input
                placeholder="Buscar produto no estoque..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                className="h-12 pl-9 text-base font-bold"
              />
            </div>
            {products.length === 0 ? (
              <p className="text-xs text-muted-foreground">Nenhum produto cadastrado no estoque.</p>
            ) : (
              <div className="max-h-56 overflow-y-auto border border-border rounded-xl divide-y">
                {filteredProducts.length === 0 ? (
                  <p className="p-3 text-sm text-muted-foreground text-center">
                    Nenhum produto encontrado.
                  </p>
                ) : (
                  filteredProducts.map((p) => {
                    const price = priceOf(p);
                    const cost = costOf(p);
                    const profit = price - cost;
                    const disabled = p.current_stock < 1;
                    return (
                      <button
                        key={p.id}
                        type="button"
                        disabled={disabled}
                        onClick={() => addToCart(p)}
                        className="w-full text-left p-3 hover:bg-secondary/60 disabled:opacity-50 disabled:cursor-not-allowed"
                      >
                        <div className="flex items-center justify-between gap-3">
                          <div className="min-w-0">
                            <p className="font-bold text-sm truncate">{p.name}</p>
                            <p className="text-[11px] text-muted-foreground">
                              Em estoque: {p.current_stock} un · Custo R$ {cost.toFixed(2)} · Lucro
                              R$ {profit.toFixed(2)}
                            </p>
                          </div>
                          <div className="text-right shrink-0">
                            <p className="font-black text-sm">R$ {price.toFixed(2)}</p>
                            {disabled && (
                              <p className="text-[10px] font-bold text-red-600">Sem estoque</p>
                            )}
                          </div>
                        </div>
                      </button>
                    );
                  })
                )}
              </div>
            )}
          </div>

          {/* Cart */}
          {cart.length > 0 && (
            <div className="space-y-2">
              <Label className="text-sm font-black uppercase tracking-widest">Itens da venda</Label>
              <div className="space-y-2">
                {cart.map((item) => (
                  <div
                    key={item.productId}
                    className="p-3 rounded-xl border border-border bg-secondary/40 space-y-2"
                  >
                    <div className="flex items-center justify-between gap-2">
                      <div className="min-w-0">
                        <p className="font-bold text-sm truncate">{item.name}</p>
                        <p className="text-[11px] text-muted-foreground">
                          Estoque: {item.stock} un
                        </p>
                      </div>
                      <Button
                        type="button"
                        size="icon"
                        variant="ghost"
                        className="h-8 w-8"
                        onClick={() => removeItem(item.productId)}
                      >
                        <Trash2 className="h-4 w-4 text-red-600" />
                      </Button>
                    </div>
                    <div className="grid grid-cols-[auto,1fr,auto] items-center gap-2">
                      <div className="flex items-center gap-1">
                        <Button
                          type="button"
                          size="icon"
                          variant="outline"
                          className="h-8 w-8 rounded-lg"
                          onClick={() => updateQty(item.productId, -1)}
                        >
                          <Minus className="h-3 w-3" />
                        </Button>
                        <span className="w-8 text-center font-black">{item.quantity}</span>
                        <Button
                          type="button"
                          size="icon"
                          variant="outline"
                          className="h-8 w-8 rounded-lg"
                          onClick={() => updateQty(item.productId, 1)}
                        >
                          <Plus className="h-3 w-3" />
                        </Button>
                      </div>
                      <div className="flex items-center gap-1">
                        <span className="text-xs font-bold text-muted-foreground">R$</span>
                        <Input
                          type="number"
                          step="0.01"
                          min="0"
                          value={item.unitPrice}
                          onChange={(e) =>
                            updatePrice(item.productId, parseFloat(e.target.value) || 0)
                          }
                          className="h-8 text-sm font-bold"
                        />
                      </div>
                      <span className="text-sm font-black tabular-nums">
                        R$ {(item.unitPrice * item.quantity).toFixed(2)}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
              <div className="flex items-center justify-between p-3 rounded-xl bg-primary/5 border-2 border-primary/20">
                <span className="font-black uppercase tracking-widest text-xs">Total da venda</span>
                <span className="text-2xl font-black italic">R$ {cartTotal.toFixed(2)}</span>
              </div>
            </div>
          )}

          {/* Payment + date + note */}
          <div className="grid grid-cols-2 gap-3">
            <div className="space-y-2">
              <Label className="text-sm font-black uppercase tracking-widest">Pagamento</Label>
              <Select value={paymentMethod} onValueChange={setPaymentMethod}>
                <SelectTrigger className="h-12 text-base font-bold">
                  <SelectValue />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="pix" className="font-bold">
                    PIX
                  </SelectItem>
                  <SelectItem value="money" className="font-bold">
                    Dinheiro
                  </SelectItem>
                  <SelectItem value="card" className="font-bold">
                    Cartão
                  </SelectItem>
                  <SelectItem value="other" className="font-bold">
                    Outro
                  </SelectItem>
                </SelectContent>
              </Select>
            </div>
            <div className="space-y-2">
              <Label className="text-sm font-black uppercase tracking-widest">Data</Label>
              <Input
                type="date"
                value={productDate}
                onChange={(e) => setProductDate(e.target.value)}
                className="h-12 text-base font-bold"
              />
            </div>
          </div>
          <div className="space-y-2">
            <Label className="text-sm font-black uppercase tracking-widest">Observação</Label>
            <Textarea
              placeholder="Opcional"
              value={productNote}
