<file path="src/routes/dashboard/_layout/settings/business.tsx">
import { createFileRoute } from "@tanstack/react-router";
import { useEffect, useState } from "react";
import { supabase } from "@/integrations/supabase/client";
import {
  Store,
  MapPin,
  Phone,
  Instagram,
  Clock,
  Save,
  Loader2,
  Image as ImageIcon,
} from "lucide-react";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { toast } from "sonner";
import { ErrorBoundary } from "@/components/error-boundary";
import { Switch } from "@/components/ui/switch";

export const Route = createFileRoute("/dashboard/_layout/settings/business")({
  component: BusinessSettingsPageWrapper,
});

function BusinessSettingsPageWrapper() {
  return (
    <ErrorBoundary>
      <BusinessSettingsPage />
    </ErrorBoundary>
  );
}

const DAYS = [
  { id: "mon", label: "Segunda" },
  { id: "tue", label: "Terça" },
  { id: "wed", label: "Quarta" },
  { id: "thu", label: "Quinta" },
  { id: "fri", label: "Sexta" },
  { id: "sat", label: "Sábado" },
  { id: "sun", label: "Domingo" },
];

function BusinessSettingsPage() {
  const [profile, setProfile] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    fetchProfile();
  }, []);

  const fetchProfile = async () => {
    try {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) return;

      const { data, error } = await supabase
        .from("profiles")
        .select("*")
        .eq("id", user.id)
        .single();

      if (error) throw error;
      setProfile(data);
    } catch (error: any) {
      toast.error("Erro ao carregar dados da barbearia");
    } finally {
      setLoading(false);
    }
  };

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    setSaving(true);
    try {
      const { error } = await supabase
        .from("profiles")
        .update({
          barber_shop_name: profile.barber_shop_name,
          business_address: profile.business_address,
          business_city: profile.business_city,
          business_state: profile.business_state,
          business_zip: profile.business_zip,
          business_phone: profile.business_phone,
          business_whatsapp: profile.business_whatsapp,
          business_instagram: profile.business_instagram,
          opening_hours: profile.opening_hours,
          updated_at: new Date().toISOString(),
        })
        .eq("id", profile.id);

      if (error) throw error;
      toast.success("Dados da unidade salvos!");
    } catch (error: any) {
      toast.error("Erro ao salvar alterações");
    } finally {
      setSaving(false);
    }
  };

  if (loading)
    return (
      <div className="flex flex-col items-center justify-center py-24 animate-pulse">
        <Loader2 className="h-8 w-8 animate-spin text-primary mb-4" />
        <div className="text-xl font-black text-muted-foreground uppercase tracking-widest">
          Carregando unidade...
        </div>
      </div>
    );

  return (
    <div className="space-y-8 max-w-4xl mx-auto pb-20">
      <header>
        <h1 className="text-3xl font-black tracking-tight uppercase italic">
          {profile?.barber_shop_name || "Sua Unidade"}
        </h1>
        <p className="text-muted-foreground font-medium text-lg">
          Gerencie os detalhes públicos e horários da sua barbearia.
        </p>
      </header>

      <form onSubmit={handleSave} className="grid gap-8">
        {/* Basic Info */}
        <Card className="rounded-[2rem] border-border bg-card shadow-sm overflow-hidden">
          <CardHeader className="p-8 pb-0">
            <CardTitle className="text-xl font-black uppercase italic tracking-tight flex items-center gap-2">
              <Store className="h-6 w-6 text-primary" /> Informações Básicas
            </CardTitle>
          </CardHeader>
          <CardContent className="p-8 space-y-6">
            <div className="grid gap-6 md:grid-cols-2">
              <div className="space-y-2">
                <Label className="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">
                  Nome da Barbearia
                </Label>
                <Input
                  value={profile?.barber_shop_name || ""}
                  onChange={(e) => setProfile({ ...profile, barber_shop_name: e.target.value })}
                  placeholder="Ex: Barber Shop Professional"
                  className="h-12 font-bold rounded-xl"
                />
              </div>
              <div className="space-y-2">
                <Label className="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">
                  Logo da Unidade
                </Label>
                <div className="flex items-center gap-4">
                  <div className="h-12 w-12 rounded-xl bg-secondary flex items-center justify-center border border-border">
                    <ImageIcon className="h-6 w-6 text-muted-foreground" />
                  </div>
                  <Button
                    type="button"
                    variant="outline"
                    className="rounded-xl h-12 font-black uppercase text-xs"
                  >
                    ALTERAR LOGO
                  </Button>
                </div>
              </div>
            </div>

            <div className="grid gap-6 md:grid-cols-3">
              <div className="space-y-2">
                <Label className="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">
                  Telefone Fixo
                </Label>
                <Input
                  value={profile?.business_phone || ""}
                  onChange={(e) => setProfile({ ...profile, business_phone: e.target.value })}
                  className="h-12 font-bold rounded-xl"
                />
              </div>
              <div className="space-y-2">
                <Label className="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">
                  WhatsApp de Contato
                </Label>
                <Input
                  value={profile?.business_whatsapp || ""}
                  onChange={(e) => setProfile({ ...profile, business_whatsapp: e.target.value })}
                  className="h-12 font-bold rounded-xl"
                />
              </div>
              <div className="space-y-2">
                <Label className="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">
                  Instagram (@usuario)
                </Label>
                <Input
                  value={profile?.business_instagram || ""}
                  onChange={(e) => setProfile({ ...profile, business_instagram: e.target.value })}
                  className="h-12 font-bold rounded-xl"
                />
              </div>
            </div>
          </CardContent>
        </Card>

        {/* Location Info */}
        <Card className="rounded-[2rem] border-border bg-card shadow-sm overflow-hidden">
          <CardHeader className="p-8 pb-0">
            <CardTitle className="text-xl font-black uppercase italic tracking-tight flex items-center gap-2">
              <MapPin className="h-6 w-6 text-primary" /> Endereço
            </CardTitle>
          </CardHeader>
          <CardContent className="p-8 space-y-6">
            <div className="space-y-2">
              <Label className="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">
                Endereço Completo
              </Label>
              <Input
                value={profile?.business_address || ""}
                onChange={(e) => setProfile({ ...profile, business_address: e.target.value })}
                placeholder="Ex: Av. Principal, 123 - Centro"
                className="h-12 font-bold rounded-xl"
              />
            </div>
            <div className="grid gap-6 md:grid-cols-3">
              <div className="space-y-2">
                <Label className="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">
                  Cidade
                </Label>
                <Input
                  value={profile?.business_city || ""}
                  onChange={(e) => setProfile({ ...profile, business_city: e.target.value })}
                  className="h-12 font-bold rounded-xl"
                />
              </div>
              <div className="space-y-2">
                <Label className="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">
                  Estado
                </Label>
                <Input
                  value={profile?.business_state || ""}
                  onChange={(e) => setProfile({ ...profile, business_state: e.target.value })}
                  className="h-12 font-bold rounded-xl"
                />
              </div>
              <div className="space-y-2">
                <Label className="text-xs font-black uppercase tracking-widest text-muted-foreground ml-1">
                  CEP
                </Label>
                <Input
                  value={profile?.business_zip || ""}
                  onChange={(e) => setProfile({ ...profile, business_zip: e.target.value })}
                  className="h-12 font-bold rounded-xl"
                />
              </div>
            </div>
          </CardContent>
        </Card>

        {/* Opening Hours */}
        <Card className="rounded-[2rem] border-border bg-card shadow-sm overflow-hidden">
          <CardHeader className="p-8 pb-0">
            <CardTitle className="text-xl font-black uppercase italic tracking-tight flex items-center gap-2">
              <Clock className="h-6 w-6 text-primary" /> Horário de Funcionamento
            </CardTitle>
          </CardHeader>
          <CardContent className="p-8 space-y-4">
            {DAYS.map((day) => (
              <div
                key={day.id}
                className="flex items-center justify-between p-4 bg-secondary/20 rounded-2xl border border-border"
              >
                <div className="flex items-center gap-4">
                  <Switch
                    checked={profile?.opening_hours?.[day.id]?.active}
                    onCheckedChange={(checked) => {
                      const newHours = { ...profile.opening_hours };
                      newHours[day.id] = { ...newHours[day.id], active: checked };
                      setProfile({ ...profile, opening_hours: newHours });
                    }}
                  />
                  <span className="font-black uppercase italic text-sm tracking-tight w-24">
                    {day.label}
                  </span>
                </div>

                <div className="flex items-center gap-2">
                  <Input
                    type="time"
                    value={profile?.opening_hours?.[day.id]?.open || "09:00"}
                    disabled={!profile?.opening_hours?.[day.id]?.active}
                    onChange={(e) => {
                      const newHours = { ...profile.opening_hours };
                      newHours[day.id] = { ...newHours[day.id], open: e.target.value };
                      setProfile({ ...profile, opening_hours: newHours });
                    }}
                    className="w-24 h-10 font-bold"
                  />
                  <span className="text-muted-foreground">às</span>
                  <Input
                    type="time"
                    value={profile?.opening_hours?.[day.id]?.close || "18:00"}
                    disabled={!profile?.opening_hours?.[day.id]?.active}
                    onChange={(e) => {
                      const newHours = { ...profile.opening_hours };
                      newHours[day.id] = { ...newHours[day.id], close: e.target.value };
                      setProfile({ ...profile, opening_hours: newHours });
                    }}
                    className="w-24 h-10 font-bold"
                  />
                </div>
              </div>
            ))}
          </CardContent>
        </Card>

        <div className="flex justify-end mt-8">
          <Button
            type="submit"
            className="h-16 rounded-2xl font-black text-lg uppercase italic shadow-2xl shadow-primary/20 gap-3 w-full md:w-auto"
            disabled={saving}
          >
            {saving ? <Loader2 className="h-6 w-6 animate-spin" /> : <Save className="h-6 w-6" />}
            SALVAR ALTERAÇÕES DA UNIDADE
          </Button>
        </div>
      </form>
    </div>
  );
}
</file>

<file path="src/routes/dashboard/_layout/settings/communications.tsx">
import { createFileRoute } from "@tanstack/react-router";
import * as React from "react";
import { useEffect, useMemo, useState } from "react";
import { supabase } from "@/integrations/supabase/client";
import {
  Loader2,
  Search,
  Bell,
  CreditCard,
  Calendar,
  Wallet,
  User,
  Save,
  Send,
} from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Switch } from "@/components/ui/switch";
import { toast } from "sonner";
import { ErrorBoundary } from "@/components/error-boundary";
import {
  NOTIFICATION_EVENTS,
  CATEGORY_LABELS,
  CATEGORY_DESCRIPTIONS,
  eventsByCategory,
  type NotificationCategory,
} from "@/lib/notifications/registry";
import { notify } from "@/lib/notifications/notify";

export const Route = createFileRoute("/dashboard/_layout/settings/communications")({
  component: CommunicationsWrapper,
});

function CommunicationsWrapper() {
  return (
    <ErrorBoundary>
      <CommunicationsPage />
    </ErrorBoundary>
  );
}

const CATEGORY_ICONS: Record<NotificationCategory, React.ReactNode> = {
  conta: <User className="h-4 w-4" />,
  assinatura: <CreditCard className="h-4 w-4" />,
  agendamento: <Calendar className="h-4 w-4" />,
  financeiro: <Wallet className="h-4 w-4" />,
};

function CommunicationsPage() {
  const [userId, setUserId] = useState<string | null>(null);
  const [prefs, setPrefs] = useState<Record<string, boolean>>({});
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [query, setQuery] = useState("");

  useEffect(() => {
    (async () => {
      const {
        data: { user },
      } = await supabase.auth.getUser();
      if (!user) return setLoading(false);
      setUserId(user.id);
      const { data } = await supabase
        .from("profiles")
        .select("notification_preferences")
        .eq("id", user.id)
        .maybeSingle();
      const stored = (data?.notification_preferences as Record<string, boolean> | null) ?? {};
      // Aplica defaults do catálogo para eventos ainda não definidos.
      const merged: Record<string, boolean> = {};
      for (const ev of NOTIFICATION_EVENTS) {
        merged[ev.key] = stored[ev.key] ?? ev.defaultEnabled;
      }
      setPrefs(merged);
      setLoading(false);
    })();
  }, []);

  const grouped = useMemo(() => eventsByCategory(), []);

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return grouped;
    const out: typeof grouped = { conta: [], assinatura: [], agendamento: [], financeiro: [] };
    for (const cat of Object.keys(grouped) as NotificationCategory[]) {
      out[cat] = grouped[cat].filter(
        (e) =>
          e.label.toLowerCase().includes(q) ||
          e.description.toLowerCase().includes(q) ||
          e.key.toLowerCase().includes(q),
      );
    }
    return out;
  }, [grouped, query]);

  const setPref = (key: string, v: boolean) => setPrefs((p) => ({ ...p, [key]: v }));

  const toggleCategory = (cat: NotificationCategory, v: boolean) => {
    const patch: Record<string, boolean> = {};
    for (const ev of grouped[cat]) patch[ev.key] = v;
    setPrefs((p) => ({ ...p, ...patch }));
  };

  const save = async () => {
    if (!userId) return;
    setSaving(true);
    try {
      const { error } = await supabase
        .from("profiles")
        .update({ notification_preferences: prefs, updated_at: new Date().toISOString() } as any)
        .eq("id", userId);
      if (error) throw error;
      toast.success("Preferências de comunicação salvas");
    } catch (err: any) {
      toast.error(err?.message || "Erro ao salvar");
    } finally {
      setSaving(false);
    }
  };

  const sendTest = async (key: string) => {
    const res = await notify(key, {
      data: {
        plano: "Profissional",
        cliente: "Cliente Teste",
        data: "amanhã",
        hora: "14:00",
        servico: "Corte",
        valor: "R$ 50,00",
        vencimento: "30/11",
      },
    });
    if (res.ok && res.delivered) toast.success("Notificação de teste enviada");
    else if (res.ok) toast.info("Este evento está desativado para você");
    else toast.error("Falha ao enviar teste");
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center py-24 text-muted-foreground">
        <Loader2 className="h-5 w-5 animate-spin mr-2" />
        <span className="text-sm">Carregando preferências…</span>
      </div>
    );
  }

  return (
    <div className="max-w-4xl mx-auto pb-16 space-y-6">
      <header className="flex flex-wrap items-end justify-between gap-3">
        <div className="min-w-0">
          <h1 className="text-2xl md:text-[28px] font-semibold tracking-tight flex items-center gap-2">
            <Bell className="h-6 w-6 text-primary" /> Central de Comunicação
          </h1>
          <p className="text-sm text-muted-foreground mt-1">
            Escolha quais avisos automáticos você deseja receber.
          </p>
        </div>
        <div className="relative w-full md:w-72">
          <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
          <Input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="Buscar comunicação..."
            className="pl-9 h-10 rounded-xl"
          />
        </div>
      </header>

      {(Object.keys(filtered) as NotificationCategory[]).map((cat) => {
        const events = filtered[cat];
        if (events.length === 0) return null;
        const allOn = events.every((e) => prefs[e.key]);
        return (
          <section
            key={cat}
            className="rounded-2xl border border-border bg-card shadow-sm overflow-hidden"
          >
            <header className="flex items-center justify-between gap-3 px-5 py-4 border-b border-border">
              <div className="flex items-center gap-3 min-w-0">
                <span className="h-9 w-9 rounded-lg bg-secondary flex items-center justify-center text-muted-foreground shrink-0">
                  {CATEGORY_ICONS[cat]}
                </span>
                <div className="min-w-0">
                  <h2 className="text-base font-semibold">{CATEGORY_LABELS[cat]}</h2>
                  <p className="text-xs text-muted-foreground truncate">
                    {CATEGORY_DESCRIPTIONS[cat]}
                  </p>
                </div>
              </div>
              <div className="flex items-center gap-2 shrink-0">
                <span className="text-xs text-muted-foreground hidden sm:inline">Todas</span>
                <Switch checked={allOn} onCheckedChange={(v) => toggleCategory(cat, v)} />
              </div>
            </header>
            <ul className="divide-y divide-border">
              {events.map((ev) => (
                <li key={ev.key} className="flex items-center gap-4 px-5 py-4">
                  <div className="min-w-0 flex-1">
                    <p className="text-sm font-medium truncate">{ev.label}</p>
                    <p className="text-xs text-muted-foreground">{ev.description}</p>
                    <div className="flex flex-wrap gap-1.5 mt-1.5">
                      {ev.channels.map((c) => (
                        <span
                          key={c}
                          className="text-[10px] uppercase tracking-wide font-medium px-1.5 py-0.5 rounded-md bg-secondary text-muted-foreground border border-border"
                        >
                          {channelLabel(c)}
                        </span>
                      ))}
                    </div>
                  </div>
                  <button
                    type="button"
                    onClick={() => sendTest(ev.key)}
                    className="hidden sm:inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-primary shrink-0"
                    title="Enviar notificação de teste"
                  >
                    <Send className="h-3.5 w-3.5" /> Testar
                  </button>
                  <Switch checked={!!prefs[ev.key]} onCheckedChange={(v) => setPref(ev.key, v)} />
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      <div className="rounded-xl border border-border bg-secondary/30 p-4 text-xs text-muted-foreground">
        E-mail é o canal principal hoje. WhatsApp e SMS estão preparados na arquitetura e serão
        ativados nas próximas integrações.
      </div>

      <div className="sticky bottom-4 flex justify-end">
        <Button onClick={save} disabled={saving} className="h-11 rounded-xl px-6 shadow-lg">
          {saving ? (
            <Loader2 className="h-4 w-4 animate-spin mr-2" />
          ) : (
            <Save className="h-4 w-4 mr-2" />
          )}
          Salvar preferências
        </Button>
      </div>
    </div>
  );
}

function channelLabel(c: string) {
  switch (c) {
    case "email":
      return "E-mail";
    case "in_app":
      return "No app";
    case "whatsapp":
      return "WhatsApp";
    case "sms":
      return "SMS";
    default:
      return c;
  }
}
