          {(isEnabled("services") || isEnabled("recovery")) && (
            <div
              className={`grid gap-6 ${
                isEnabled("services") && isEnabled("recovery") ? "md:grid-cols-2" : "md:grid-cols-1"
              }`}
            >
              {isEnabled("services") && <TopServices services={topServices} />}
