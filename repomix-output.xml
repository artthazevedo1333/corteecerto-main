<file path="src/components/dashboard/FinancialGoal.tsx">
import { Card, CardContent } from "@/components/ui/card";
import { Target, TrendingUp } from "lucide-react";

interface FinancialGoalProps {
  current?: number | null;
  goal?: number | null;
}

export function FinancialGoal({ current, goal }: FinancialGoalProps) {
  const safeCurrent = Number(current) || 0;
  const safeGoal = Number(goal) || 0;
  const percent = safeGoal > 0 ? Math.min(Math.round((safeCurrent / safeGoal) * 100), 100) : 0;
  const remaining = Math.max(safeGoal - safeCurrent, 0);

  const now = new Date();
  const dayOfMonth = now.getDate();
  const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
  const dailyPace = dayOfMonth > 0 ? safeCurrent / dayOfMonth : 0;
  const projected = Math.round(dailyPace * daysInMonth);
  const daysToReach = dailyPace > 0 && remaining > 0 ? Math.ceil(remaining / dailyPace) : 0;
  const daysLeftInMonth = daysInMonth - dayOfMonth;

  const currency = new Intl.NumberFormat("pt-BR", {
    style: "currency",
    currency: "BRL",
    maximumFractionDigits: 0,
  });

  const forecastLabel =
    safeGoal === 0
      ? "Defina uma meta em Configurações"
      : percent >= 100
        ? "Meta alcançada este mês 🎉"
        : daysToReach === 0
          ? "Sem dados suficientes ainda"
          : daysToReach <= daysLeftInMonth
            ? `No ritmo atual, meta em ${daysToReach} dia${daysToReach > 1 ? "s" : ""}`
            : `No ritmo atual, projeção de ${currency.format(projected)}`;

  return (
    <Card className="group rounded-3xl border-border bg-card shadow-sm overflow-hidden transition-all hover:shadow-md hover:-translate-y-0.5">
      <CardContent className="p-6 space-y-5">
        <div className="flex items-start justify-between">
          <div className="flex items-center gap-3">
            <div className="rounded-2xl bg-primary/10 p-2.5 ring-1 ring-primary/15">
              <Target className="h-5 w-5 text-primary" />
            </div>
            <div>
              <p className="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Meta mensal
              </p>
              <p className="text-sm text-muted-foreground">
                {currency.format(safeCurrent)} de {currency.format(safeGoal)}
              </p>
            </div>
          </div>
          <div className="text-right">
            <p className="text-3xl font-bold tracking-tight tabular-nums">
              {percent}
              <span className="text-lg text-muted-foreground">%</span>
            </p>
          </div>
        </div>

        <div className="space-y-2">
          <div
            className="relative h-2.5 w-full overflow-hidden rounded-full bg-secondary"
            role="progressbar"
            aria-valuemin={0}
            aria-valuemax={100}
            aria-valuenow={percent}
          >
            <div
              className="h-full rounded-full bg-gradient-to-r from-primary/80 to-primary transition-all duration-700 ease-out"
              style={{ width: `${percent}%` }}
            />
          </div>
        </div>

        <div className="grid grid-cols-2 gap-3">
          <div className="rounded-2xl bg-secondary/50 p-3">
            <p className="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
              Faltam
            </p>
            <p className="text-lg font-bold tabular-nums mt-1">{currency.format(remaining)}</p>
          </div>
          <div className="rounded-2xl bg-primary/5 p-3 ring-1 ring-primary/10">
            <p className="text-[11px] font-medium uppercase tracking-wider text-primary/80">
              Projeção
            </p>
            <p className="text-lg font-bold tabular-nums mt-1 text-primary">
              {currency.format(projected)}
            </p>
          </div>
        </div>

        <div className="flex items-center gap-2 text-xs text-muted-foreground pt-1">
          <TrendingUp className="h-3.5 w-3.5" />
          <span>{forecastLabel}</span>
        </div>
      </CardContent>
    </Card>
  );
}
</file>

<file path="src/components/dashboard/InactiveClients.tsx">
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { Button } from "@/components/ui/button";
import { AlertTriangle, MessageCircle, ChevronRight, User } from "lucide-react";
import { Link } from "@tanstack/react-router";
import { format, parseISO } from "date-fns";

interface InactiveClient {
  id: string;
  name: string;
  phone: string;
  last_visit: string;
  days_since_last_visit: number;
  risk_level: "green" | "yellow" | "red";
}

interface InactiveClientsProps {
  clients: InactiveClient[];
}

export function InactiveClients({ clients }: InactiveClientsProps) {
  const sendWhatsApp = (phone: string, name: string) => {
    const message = encodeURIComponent(
      `Olá, ${name}! Tudo bem? Sentimos sua falta aqui na barbearia. Que tal agendar um horário para esta semana?`,
    );
    window.open(`https://wa.me/55${phone.replace(/\D/g, "")}?text=${message}`, "_blank");
  };

  const getRiskColor = (risk: string) => {
    switch (risk) {
      case "red":
        return "bg-destructive text-destructive-foreground";
      case "yellow":
        return "bg-yellow-500 text-black";
      default:
        return "bg-green-500 text-primary-foreground";
    }
  };

  const getRiskLabel = (risk: string) => {
    switch (risk) {
      case "red":
        return "CRÍTICO (+60 dias)";
      case "yellow":
        return "EM RISCO (+30 dias)";
      default:
        return "OK";
    }
  };

  return (
    <Card className="rounded-[2rem] border-border bg-card shadow-sm overflow-hidden">
      <CardHeader className="pb-2 flex flex-row items-center justify-between space-y-0">
        <CardTitle className="text-xl font-black uppercase italic tracking-tight flex items-center gap-2">
          <AlertTriangle className="h-5 w-5 text-yellow-500" />
          Recuperar Clientes
        </CardTitle>
        <Link
          to="/dashboard/clients"
          className="text-primary hover:underline font-black flex items-center gap-1 text-[10px] uppercase tracking-widest"
        >
          Ver todos <ChevronRight className="h-4 w-4" />
        </Link>
      </CardHeader>
      <CardContent className="p-0">
        {clients.length > 0 ? (
          <div className="divide-y divide-border">
            {clients.slice(0, 5).map((client) => (
              <div
                key={client.id}
                className="flex items-center justify-between p-4 hover:bg-secondary/30 transition-colors"
              >
                <div className="flex items-center gap-3">
                  <div className="h-12 w-12 rounded-xl bg-secondary flex items-center justify-center border border-border">
                    <User className="h-6 w-6 text-muted-foreground" />
                  </div>
                  <div>
                    <div className="flex items-center gap-2 mb-0.5">
                      <p className="font-black text-sm italic break-words">{client.name}</p>
                      <span
                        className={`text-[8px] font-black px-1.5 py-0.5 rounded-full ${getRiskColor(client.risk_level)}`}
                      >
                        {getRiskLabel(client.risk_level)}
                      </span>
                    </div>
                    <p className="text-xs text-muted-foreground font-medium">
                      Última visita: {format(parseISO(client.last_visit), "dd/MM/yy")}
                    </p>
                  </div>
                </div>
                <Button
                  size="sm"
                  variant="outline"
                  className="rounded-xl h-9 font-black text-[10px] gap-2 border-primary/20 hover:bg-primary hover:text-white"
                  onClick={() => sendWhatsApp(client.phone, client.name)}
                >
                  <MessageCircle className="h-4 w-4" />
                  RECUPERAR
                </Button>
              </div>
            ))}
          </div>
        ) : (
          <div className="p-12 text-center">
            <div className="h-16 w-16 rounded-full bg-secondary flex items-center justify-center mx-auto mb-4 border border-border">
              <User className="h-8 w-8 text-muted-foreground/30" />
            </div>
            <h3 className="text-xl font-black uppercase italic tracking-tight">Tudo em dia!</h3>
            <p className="text-muted-foreground font-medium mt-1">
              Nenhum cliente em risco de perda.
            </p>
          </div>
        )}
      </CardContent>
    </Card>
  );
}
