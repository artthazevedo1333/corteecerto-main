import type { SubscriptionPlan } from "@/lib/subscription";

export type PaymentGateway = "asaas" | "mercadopago" | "stripe";

export interface CheckoutRequest {
  userId: string;
  email: string;
  plan: SubscriptionPlan;
  amountCents: number;
  currency: string;
  successUrl: string;
  cancelUrl: string;
